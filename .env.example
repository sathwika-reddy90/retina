# Optional: HTTPS endpoint that accepts multipart/form-data POSTs from the
# enquiry, callback, contact and job-application forms (for example a
# WordPress REST route, Formspree, or an internal API). Each submission
# includes a `form` field: franchise | advice | contact | job.
# When unset, forms fall back to opening a pre-filled email to the right inbox.
PUBLIC_FORM_ENDPOINT=

# Origin that hosts /policy-documents/ and /technical-docs/ PDFs.
# Leave as the live site unless the PDFs are moved alongside this build.
PUBLIC_DOCS_ORIGIN=https://www.retinapaints.com
