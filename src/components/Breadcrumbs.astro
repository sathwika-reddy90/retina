---
import Icon from './Icon.astro';
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
const trail = [{ label: 'Home', href: '/' }, ...items];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.label,
    ...(t.href ? { item: new URL(t.href, Astro.site).href } : {}),
  })),
};
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol role="list">
    {trail.map((t, i) => (
      <li>
        {i > 0 && <Icon name="chevron-right" />}
        {t.href && i < trail.length - 1 ? <a href={t.href}>{t.label}</a> : <span aria-current="page">{t.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
  .crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem; margin: 0; padding: 0; list-style: none; font-size: var(--fs-ui); }
  .crumbs li { display: inline-flex; align-items: center; gap: 0.25rem; color: var(--ink-soft); }
  .crumbs :global(.icon) { width: 0.9rem; height: 0.9rem; color: var(--ink-mute); }
  .crumbs a { color: var(--ink-soft); text-decoration: none; }
  .crumbs a:hover { color: var(--orange-700); text-decoration: underline; }
  .crumbs [aria-current] { color: var(--ink-deep); font-weight: 500; }
</style>
