---
// A room photograph with its walls painted in a Retina shade. Same layering as the
// visualizer: the overlay has its walls cut out, so the paint layer only shows on
// wall regions, and the lighting maps restore shadows and daylight on top.
// Pass hex for a fixed colour, or omit it and set --wall on an ancestor to repaint it live.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { rooms } from '@/data/colours';

interface Props {
  room: string;
  hex?: string;
  alt: string;
  sizes: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { room: roomId, hex, alt, sizes, widths = [480, 960], loading = 'lazy', class: cls } = Astro.props;

const room = rooms.find((r) => r.id === roomId);
if (!room) throw new Error(`PaintedRoom: unknown room "${roomId}"`);

const maps = import.meta.glob<{ default: ImageMetadata }>('@/assets/rooms/light/*.png', { eager: true });
const fileId = room.id === 'bed-room' ? 'bedroom' : room.id;
const mapFor = (kind: 'shade' | 'light') => Object.entries(maps).find(([p]) => p.endsWith(`/${fileId}-${kind}.png`))?.[1].default;
const ROOMS_WITHOUT_DAYLIGHT = new Set(['apartment', 'house']);

const layer = async (src: ImageMetadata | undefined, quality: number) => {
  if (!src) return undefined;
  const ws = [...new Set(widths.map((w) => Math.min(w, src.width)))];
  const set = await Promise.all(ws.map((width) => getImage({ src, width, format: 'webp', quality })));
  return { src: set[set.length - 1].src, srcset: set.map((img, i) => `${img.src} ${ws[i]}w`).join(', ') };
};
const [photo, shade, light] = await Promise.all([
  layer(room.image, 80),
  layer(mapFor('shade'), 72),
  layer(ROOMS_WITHOUT_DAYLIGHT.has(room.id) ? undefined : mapFor('light'), 72),
]);
---

<div class:list={['painted', cls]} style={hex ? `--wall:${hex}` : undefined}>
  <div class="painted__paint" aria-hidden="true"></div>
  {shade && <img class="painted__shade" src={shade.src} srcset={shade.srcset} sizes={sizes} alt="" aria-hidden="true" width={room.image.width} height={room.image.height} loading={loading} decoding="async" />}
  {light && <img class="painted__light" src={light.src} srcset={light.srcset} sizes={sizes} alt="" aria-hidden="true" width={room.image.width} height={room.image.height} loading={loading} decoding="async" />}
  <img class="painted__room" src={photo!.src} srcset={photo!.srcset} sizes={sizes} alt={alt} width={room.image.width} height={room.image.height} loading={loading} decoding="async" />
</div>

<style>
  .painted { position: relative; overflow: hidden; isolation: isolate; background: var(--sand); }
  .painted > * { position: absolute; inset: 0; width: 100%; height: 100%; }
  .painted img { object-fit: cover; object-position: var(--painted-pos, 50% 50%); pointer-events: none; }
  .painted__paint { background: var(--wall); transition: background-color 700ms var(--ease-in-out); }
  .painted__shade { mix-blend-mode: multiply; }
  .painted__light { mix-blend-mode: screen; }
</style>
