---
// Homepage hero: five full-width campaign banners, each with its own photograph,
// colour tone and foreground accent. Every layer is real: licensed photography
// (src/assets/banners/CREDITS.md), product cutouts and copy from the product data,
// real Retina shade codes, and verified company credentials. Behaviour: scripts/slideshow.ts.
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import { productBySlug } from '@/data/products';
import { findShade } from '@/data/colours';
import modernLiving from '@/assets/banners/modern-living.jpg';
import villa from '@/assets/banners/villa-exterior.jpg';
import colourWalls from '@/assets/imagery/interior-colour.jpg';
import limewash from '@/assets/banners/limewash-interior.jpg';
import painting from '@/assets/banners/painting-wall.jpg';

const p = (slug: string) => productBySlug(slug)!;
// Display order, left to right: Weather Expert leads from the exact centre, two packs either side.
const range = ['x-gen', 'expo-ultimax', 'weather-expert', 'expo-advanced', 'eco-damp'].map(p);
const leadPack = 2;
const exteriors = ['expo-ultimax', 'weather-expert', 'expo-advanced'].map(p);
const weatherExpert = p('weather-expert');
const finishes = [p('royal-vogue'), p('texture')];
// Closest catalogue shades to the three walls in the photograph (sampled colours).
const wallShades = [
  { code: 'QC0781', wall: 'Blue wall' },
  { code: 'QC0411', wall: 'Crimson wall' },
  { code: 'QC0901', wall: 'Green wall' },
].map((w) => ({ ...w, shade: findShade(w.code)! }));
const sizes = '100vw';
---

<section class="hero" aria-roledescription="carousel" aria-label="Retina Paints highlights" data-slideshow data-interval="6500">
  <div class="hero__slides">
    <!-- 1 · Premium modern living: Weather Expert centred in the full range on an orange base -->
    <article class="hslide hslide--living is-active" data-slide data-title="The Power of Colour" aria-roledescription="slide" aria-label="1 of 5">
      <Image src={modernLiving} alt="A contemporary living room with a navy accent wall, warm pendant lights and a blue sofa" widths={[960, 1440, 1920]} sizes={sizes} class="hslide__bg" loading="eager" fetchpriority="high" />
      <svg class="hslide__wave" viewBox="0 0 1440 300" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 74C300 6 820 -6 1440 46V300H0Z" /></svg>
      <div class="container hslide__inner">
        <div class="hslide__copy">
          <p class="hslide__eyebrow">Interior &amp; exterior paints</p>
          <h1 class="hslide__title">Transform Your Space with the Power of Colour</h1>
          <p class="hslide__text">Premium paints, primers and finishes that bring beauty and lasting quality to every room of your home.</p>
          <a class="btn btn--lg" href="/products/">Explore Our Products <Icon name="arrow-right" /></a>
        </div>
      </div>
      <ul role="list" class="hslide__features">
        <li><Icon name="award" /> Premium <br />Quality</li>
        <li><Icon name="shield" /> Up to 8 Years <br />Warranty</li>
      </ul>
      <div class="hslide__packs">
        {range.map((r, i) => (
          <span class:list={['hslide__pack', i === leadPack && 'hslide__pack--lead']}>
            {i === leadPack
              ? <Image src={r.image} alt="Retina Weather Expert, shown with X-Gen+, Expo Ultimax, Expo Advanced and Eco Damp" widths={[240, 360, 500]} sizes="(max-width: 560px) 54vw, 360px" loading="eager" />
              : <Image src={r.image} alt="" widths={[120, 200, 360]} sizes="(max-width: 560px) 26vw, 220px" loading="eager" />}
          </span>
        ))}
      </div>
    </article>

    <!-- 2 · Exterior protection: navy tone, exterior emulsions -->
    <article class="hslide hslide--villa" data-slide data-title="Exterior Protection" aria-roledescription="slide" aria-label="2 of 5" aria-hidden="true" inert>
      <Image src={villa} alt="A modern white villa with timber accents in warm afternoon light" widths={[960, 1440, 1920]} sizes={sizes} class="hslide__bg" />
      <div class="container hslide__inner">
        <div class="hslide__copy">
          <p class="hslide__eyebrow">Exterior emulsions</p>
          <h2 class="hslide__title"><span>Beauty That Lasts.</span> <span>Protection That Performs.</span></h2>
          <p class="hslide__text">Exterior paints made to keep your walls looking beautiful through sun, rain and dust, season after season.</p>
          <a class="btn btn--lg" href="/products/#exterior-emulsions">Explore Exterior Paints <Icon name="arrow-right" /></a>
        </div>
      </div>
      <div class="hslide__exterior">
        <div class="hslide__exterior-packs">
          {exteriors.map((e, i) => <Image src={e.image} alt={i === 1 ? `${e.name} pack` : ''} widths={[200, 320]} sizes="180px" class:list={['hslide__xpack', i === 1 && 'hslide__xpack--lead']} />)}
        </div>
        <a class="hslide__note" href={weatherExpert.href!}>
          <strong>{weatherExpert.name} · {weatherExpert.warranty} Years Warranty</strong>
          <span>{weatherExpert.features.slice(0, 3).join(' · ')}</span>
        </a>
      </div>
    </article>

    <!-- 3 · Discover your colours: the walls' closest Retina shades -->
    <article class="hslide hslide--colours" data-slide data-title="Discover Your Colours" aria-roledescription="slide" aria-label="3 of 5" aria-hidden="true" inert>
      <Image src={colourWalls} alt="Three living spaces with walls painted deep blue, crimson and forest green" widths={[960, 1600]} sizes={sizes} class="hslide__bg" />
      <div class="container hslide__inner">
        <div class="hslide__copy">
          <p class="hslide__eyebrow">1,000+ Retina shades</p>
          <h2 class="hslide__title"><span>Every Wall Has a Story.</span> <span>Find Yours.</span></h2>
          <p class="hslide__text">Explore curated shades for every mood and try them on the walls of your own room.</p>
          <a class="btn btn--lg" href="/colors/"><Icon name="palette" /> Explore Colours</a>
        </div>
      </div>
      <div class="hslide__swatches">
        <p class="hslide__swatches-label">Closest Retina shades to these walls</p>
        <ul role="list">
          {wallShades.map((w) => (
            <li><a href={`/colors/#${w.code}`} style={`--c:${w.shade.hex}`}><span class="hslide__chip" aria-hidden="true"></span><strong>{w.code}</strong><span>{w.wall}</span></a></li>
          ))}
        </ul>
      </div>
    </article>

    <!-- 4 · Premium interior finishes: textured walls -->
    <article class="hslide hslide--finish" data-slide data-title="Interior Finishes" aria-roledescription="slide" aria-label="4 of 5" aria-hidden="true" inert>
      <Image src={limewash} alt="A calm room with warm, textured limewash walls and a leather armchair" widths={[960, 1440, 1920]} sizes={sizes} class="hslide__bg" />
      <div class="container hslide__inner">
        <div class="hslide__copy">
          <p class="hslide__eyebrow">Interior emulsions &amp; textures</p>
          <h2 class="hslide__title">Make Ordinary Walls Extraordinary.</h2>
          <p class="hslide__text">From smooth high-sheen emulsions to decorative textures, give every wall a finish worth noticing.</p>
          <a class="btn btn--lg" href="/products/#interior-emulsions">Discover Interior Paints <Icon name="arrow-right" /></a>
        </div>
      </div>
      <ul role="list" class="hslide__products">
        {finishes.map((f) => (
          <li><a href={f.href!}><Image src={f.image} alt="" widths={[140, 240]} sizes="96px" /><span><strong>{f.name}</strong>{f.summary}</span></a></li>
        ))}
      </ul>
    </article>

    <!-- 5 · Professional quality: verified credentials, Retina green tone -->
    <article class="hslide hslide--quality" data-slide data-title="Professional Quality" aria-roledescription="slide" aria-label="5 of 5" aria-hidden="true" inert>
      <Image src={painting} alt="A painter on a stepladder rolling orange paint onto a white wall" widths={[960, 1440, 1920]} sizes={sizes} class="hslide__bg" />
      <div class="container hslide__inner">
        <div class="hslide__copy">
          <p class="hslide__eyebrow">Retina Paints Limited</p>
          <h2 class="hslide__title"><span>Quality You Can See.</span> <span>Trust You Can Feel.</span></h2>
          <p class="hslide__text">An ISO 9001:2015 certified paint manufacturer, bringing colour and protection to homes across India.</p>
          <a class="btn btn--lg" href="/about-us/company-profile/">Discover Retina Paints <Icon name="arrow-right" /></a>
        </div>
      </div>
      <ul role="list" class="hslide__badges">
        <li><Icon name="certificate" /><span><strong>ISO 9001:2015</strong>certified</span></li>
        <li><Icon name="trending-up" /><span><strong>Listed on</strong>BSE SME</span></li>
        <li><Icon name="shield" /><span><strong>Up to 8 years</strong>warranty</span></li>
      </ul>
    </article>
  </div>

  <button type="button" class="hero__arrow hero__arrow--prev" data-slide-prev aria-label="Previous slide"><Icon name="arrow-left" /></button>
  <button type="button" class="hero__arrow hero__arrow--next" data-slide-next aria-label="Next slide" data-float-avoid><Icon name="arrow-right" /></button>
  <div class="hero__controls" data-float-avoid>
    <div class="hero__dots" data-slide-dots></div>
    <button type="button" class="hero__pause" data-slide-pause aria-label="Pause slideshow" aria-pressed="false">
      <svg class="hero__pause-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="i-pause" d="M8 5v14M16 5v14" /><path class="i-play" d="M8 5l11 7-11 7z" /></svg>
    </button>
  </div>
</section>

<script>
  import { initSlideshows } from '@/scripts/slideshow';
  initSlideshows();
</script>

<style>
  .hero {
    --hero-h: clamp(34rem, calc(100svh - var(--header-h) - 3.5rem), 50rem);
    --edge: max(var(--gutter), calc((100vw - var(--container)) / 2));
    --overlap: clamp(1rem, 0.5rem + 1.5vw, 2rem); /* the quick-access card overlaps the hero bottom */
    --side: max(var(--edge), 5.75rem); /* content edge that clears the side arrows */
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #16110e;
    color: var(--white);
  }
  .hero__slides { display: grid; }

  /* Slides stack in one grid cell and cross-fade; each sets its own tone. */
  .hslide { --tone: 14 10 8; position: relative; grid-area: 1 / 1; min-height: var(--hero-h); overflow: hidden; opacity: 0; visibility: hidden; touch-action: pan-y; transition: opacity 1000ms var(--ease-in-out), visibility 0s linear 1000ms; }
  .hslide.is-active { z-index: 1; opacity: 1; visibility: visible; transition: opacity 1000ms var(--ease-in-out); }
  .hslide :global(.hslide__bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hslide::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgb(var(--tone) / 0.86) 0%, rgb(var(--tone) / 0.55) 38%, rgb(var(--tone) / 0) 66%), linear-gradient(to top, rgb(var(--tone) / 0.45), transparent 35%); pointer-events: none; }
  .hslide__inner { position: relative; z-index: 3; display: grid; align-content: center; min-height: var(--hero-h); padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) calc(var(--overlap) + 5.5rem); }
  .hslide__copy { display: grid; justify-items: start; gap: var(--s-4); max-width: 52rem; margin-left: calc(var(--side) - var(--edge)); }
  .hslide__eyebrow { font-family: var(--font-display); display: inline-flex; align-items: center; gap: 0.6rem; font-size: var(--fs-label); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--orange-300); }
  .hslide__eyebrow::before { content: ''; width: 1.75rem; height: 2px; background: currentColor; }
  .hslide__title { font-size: var(--fs-display); font-weight: var(--fw-hero); line-height: var(--lh-tight); letter-spacing: var(--tracking-display); color: var(--white); text-wrap: balance; text-shadow: 0 1px 3px rgb(0 0 0 / 0.3), 0 2px 28px rgb(0 0 0 / 0.35); }
  /* Two-sentence headlines break between the sentences, never inside one. */
  .hslide__title span { display: block; text-wrap: balance; }
  .hslide__text { max-width: 32rem; font-size: var(--fs-lead); line-height: 1.6; color: rgb(255 248 240 / 0.88); }
  .hslide__copy :global(.btn) { margin-top: var(--s-2); }

  /* 1 · Living: orange curved base, Weather Expert centred in the range of packs.
     Every pack is the same 500×522 canvas: the bucket fills 80.3% of its height, starts
     10.7% from the top, ends 9% from the bottom and sits 1.3% left of centre. The margins
     and offsets below cancel that padding, so sizes and gaps are those of the buckets. */
  .hslide--living {
    --tone: 24 16 12;
    --packs-room: calc(var(--side) + 9.5rem); /* each end of the row clears the features */
    --packs-h: min(calc(var(--hero-h) * 0.42), calc((100vw - 2 * var(--packs-room)) / 2.9), 23rem); /* the lead's canvas */
    --pack-s: calc(var(--packs-h) / 1.65); /* the four flanking packs */
    --packs-gap: calc(var(--packs-h) * 0.05);
    --packs-lift: calc(var(--packs-h) * 0.035); /* flanking packs stand further back, so slightly higher */
    --packs-base: calc(var(--overlap) + 4rem); /* floor line of the lead, above the slide dots */
    --packs-clear: calc(var(--packs-base) + var(--packs-lift) + var(--pack-s) * 0.803 + 1rem); /* room kept under the copy */
  }
  .hslide--living :global(.hslide__bg) { object-position: 70% 40%; }
  .hslide--living .hslide__inner { align-content: start; padding-top: clamp(2.5rem, 1rem + 5vh, 5.5rem); padding-bottom: var(--packs-clear); }
  .hslide__wave { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; width: 100%; height: 35%; fill: var(--orange-500); }
  /* The two features bracket the packs at either end of the wave, high enough to clear the WhatsApp button. */
  .hslide__features { position: absolute; left: var(--side); right: var(--side); bottom: calc(var(--packs-base) + 1.5rem); z-index: 3; display: flex; justify-content: space-between; margin: 0; padding: 0; list-style: none; }
  .hslide__features li { display: grid; justify-items: center; gap: 0.35rem; font-family: var(--font-display); font-size: clamp(0.95rem, 0.8rem + 0.4vw, 1.2rem); font-weight: 600; line-height: 1.2; text-align: center; color: var(--white); }
  .hslide__features :global(.icon) { width: 2.25rem; height: 2.25rem; stroke-width: 1.4; }
  .hslide__packs { position: absolute; left: 50%; bottom: var(--packs-base); z-index: 3; display: flex; align-items: flex-end; width: max-content; translate: -50% 0; }
  .hslide__pack { --h: var(--pack-s); position: relative; isolation: isolate; flex: none; height: var(--h); aspect-ratio: 500 / 522; margin-inline: calc(var(--h) * -0.0875 + var(--packs-gap) / 2); margin-bottom: calc(var(--h) * -0.09 + var(--packs-lift)); translate: 1.3% 0; }
  .hslide__pack--lead { --h: var(--packs-h); z-index: 1; margin-block: calc(var(--h) * -0.107) calc(var(--h) * -0.09); }
  .hslide__pack :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 6px 8px rgb(60 25 5 / 0.2)); }
  .hslide__pack--lead :global(img) { filter: drop-shadow(0 14px 18px rgb(60 25 5 / 0.3)); }
  /* Contact shadow on the floor line */
  .hslide__pack::after { content: ''; position: absolute; z-index: -1; left: 8%; width: 80%; bottom: 5.5%; height: 7%; border-radius: 50%; background: radial-gradient(closest-side, rgb(84 36 4 / 0.6), rgb(84 36 4 / 0)); }

  /* 2 · Villa: navy tone, exterior packs and a feature note */
  .hslide--villa { --tone: 10 20 46; }
  .hslide--villa :global(.hslide__bg) { object-position: 60% 45%; }
  .hslide__exterior { position: absolute; right: var(--side); bottom: calc(var(--overlap) + 3.5rem); z-index: 3; display: grid; justify-items: end; gap: var(--s-3); }
  .hslide__exterior-packs { display: flex; align-items: flex-end; filter: drop-shadow(0 20px 22px rgb(0 0 0 / 0.45)); }
  .hslide__exterior-packs :global(.hslide__xpack) { width: auto; height: clamp(6rem, 3rem + 6vw, 10rem); margin-inline: -0.75rem; }
  .hslide__exterior-packs :global(.hslide__xpack--lead) { position: relative; z-index: 1; height: clamp(8rem, 4rem + 8vw, 13rem); }
  .hslide__note { display: grid; gap: 0.15rem; padding: 0.65rem 1rem; border-left: 3px solid var(--orange-500); border-radius: 0 var(--r-sm) var(--r-sm) 0; background: rgb(10 20 46 / 0.78); color: rgb(255 255 255 / 0.8); font-size: var(--fs-label); text-decoration: none; }
  .hslide__note strong { font-family: var(--font-display); font-size: var(--fs-small); color: var(--white); }
  .hslide__note:hover strong { color: var(--orange-300); }

  /* 3 · Colours: shade cards for the walls in the photo */
  .hslide--colours { --tone: 12 12 18; }
  .hslide--colours :global(.hslide__bg) { object-position: 50% 40%; }
  .hslide__swatches { position: absolute; right: var(--side); bottom: calc(var(--overlap) + 3.5rem); z-index: 3; display: grid; gap: var(--s-3); }
  .hslide__swatches-label { font-family: var(--font-display); font-size: var(--fs-caption); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(255 255 255 / 0.85); text-shadow: 0 1px 8px rgb(0 0 0 / 0.5); }
  .hslide__swatches ul { display: flex; gap: var(--s-3); margin: 0; padding: 0; list-style: none; }
  .hslide__swatches a { display: grid; width: 7.5rem; padding: 0.5rem 0.5rem 0.65rem; border-radius: var(--r-sm); background: var(--white); color: var(--ink-deep); text-decoration: none; box-shadow: 0 18px 32px -16px rgb(0 0 0 / 0.6); transition: transform 300ms var(--ease-out); }
  .hslide__swatches a:hover { transform: translateY(-5px); }
  .hslide__swatches a:focus-visible { outline: 3px solid var(--orange-400); outline-offset: 3px; }
  .hslide__chip { display: block; height: 4.25rem; margin-bottom: 0.45rem; border-radius: 6px; background: var(--c); }
  .hslide__swatches strong { font-family: var(--font-display); font-size: var(--fs-small); }
  .hslide__swatches a > span:last-child { font-size: var(--fs-caption); color: var(--ink-soft); }

  /* 4 · Finish: warm brown tone, two product cards */
  .hslide--finish { --tone: 38 26 16; }
  .hslide--finish :global(.hslide__bg) { object-position: 60% 62%; }
  .hslide__products { position: absolute; right: var(--side); bottom: calc(var(--overlap) + 3.5rem); z-index: 3; display: grid; gap: var(--s-3); width: min(24rem, 34vw); margin: 0; padding: 0; list-style: none; }
  .hslide__products a { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); align-items: center; gap: var(--s-3); padding: 0.6rem 1rem 0.6rem 0.6rem; border-radius: var(--r-md); background: rgb(255 252 247 / 0.94); color: var(--ink); font-size: var(--fs-label); line-height: 1.4; text-decoration: none; box-shadow: 0 18px 32px -18px rgb(40 20 6 / 0.55); transition: transform 300ms var(--ease-out); }
  .hslide__products a:hover { transform: translateX(-4px); }
  .hslide__products a:focus-visible { outline: 3px solid var(--orange-500); outline-offset: 3px; }
  .hslide__products :global(img) { width: 100%; height: auto; }
  .hslide__products span { display: grid; gap: 0.1rem; }
  .hslide__products strong { font-family: var(--font-display); font-size: var(--fs-small); color: var(--ink-deep); }

  /* 5 · Quality: Retina green tone, verified credentials */
  .hslide--quality { --tone: 14 36 24; }
  .hslide--quality :global(.hslide__bg) { object-position: 50% 42%; }
  .hslide__badges { position: absolute; right: var(--side); bottom: calc(var(--overlap) + 3.5rem); z-index: 3; display: flex; gap: var(--s-3); margin: 0; padding: 0; list-style: none; }
  .hslide__badges li { display: flex; align-items: center; gap: 0.6rem; padding: 0.75rem 1rem; border: 1px solid rgb(255 255 255 / 0.25); border-radius: var(--r-md); background: rgb(14 36 24 / 0.72); font-size: var(--fs-label); line-height: 1.3; color: rgb(255 255 255 / 0.85); }
  .hslide__badges :global(.icon) { flex: none; width: 1.75rem; height: 1.75rem; color: var(--leaf); }
  .hslide__badges span { display: grid; }
  .hslide__badges strong { font-family: var(--font-display); font-size: var(--fs-small); color: var(--white); }

  /* Controls */
  .hero__arrow { position: absolute; top: 50%; z-index: 5; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; padding: 0; border: 0; border-radius: 50%; background: rgb(255 255 255 / 0.82); color: var(--ink-deep); box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.5); transform: translateY(-50%); transition: background-color var(--t-fast), transform var(--t-fast); }
  .hero__arrow--prev { left: clamp(0.75rem, 0.25rem + 1vw, 1.75rem); }
  .hero__arrow--next { right: clamp(0.75rem, 0.25rem + 1vw, 1.75rem); }
  .hero__arrow:hover { background: var(--orange-500); transform: translateY(-50%) scale(1.06); }
  .hero__arrow :global(.icon) { width: 1.25rem; height: 1.25rem; }
  .hero__arrow:focus-visible, .hero__pause:focus-visible { outline: 3px solid var(--white); outline-offset: 3px; }
  .hero__controls { position: absolute; left: 50%; bottom: calc(var(--overlap) + 1.1rem); z-index: 5; display: flex; align-items: center; gap: 0.6rem; transform: translateX(-50%); }
  .hero__dots { display: flex; align-items: center; gap: 0.15rem; }
  .hero__dots :global(.slideshow-dot) { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; padding: 0; border: 0; background: none; }
  .hero__dots :global(.slideshow-dot)::before { content: ''; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: rgb(255 255 255 / 0.75); transition: background-color var(--t-base), box-shadow var(--t-base), transform var(--t-base); }
  .hero__dots :global(.slideshow-dot[aria-current='true'])::before { background: transparent; box-shadow: inset 0 0 0 2.5px var(--white); transform: scale(1.5); }
  .hero__dots :global(.slideshow-dot:focus-visible) { outline: 2.5px solid var(--white); outline-offset: -2px; border-radius: 50%; }
  .hero__pause { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; padding: 0; border: 1.5px solid rgb(255 255 255 / 0.6); border-radius: 50%; background: rgb(0 0 0 / 0.25); color: var(--white); }
  .hero__pause[hidden] { display: none; }
  .hero__pause-icon { width: 0.75rem; height: 0.75rem; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .hero__pause .i-play { display: none; fill: currentColor; stroke-width: 1.5; }
  .hero__pause[aria-pressed='true'] .i-pause { display: none; }
  .hero__pause[aria-pressed='true'] .i-play { display: block; }

  /* Motion: slow zoom on the active photo, heading → text → CTA, then the accent */
  @media (prefers-reduced-motion: no-preference) {
    .hslide.is-active :global(.hslide__bg) { animation: hero-zoom 9s var(--ease-out) both; }
    .hslide.is-active .hslide__copy > * { animation: hero-rise 800ms var(--ease-out) both; }
    .hslide.is-active .hslide__copy > :nth-child(2) { animation-delay: 100ms; }
    .hslide.is-active .hslide__copy > :nth-child(3) { animation-delay: 240ms; }
    .hslide.is-active .hslide__copy > :nth-child(4) { animation-delay: 380ms; }
