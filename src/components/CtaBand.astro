---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import mark from '@/assets/brand/mark.png';
interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Transform Your Space with Retina Paints!',
  body = 'Experience the perfect blend of durability, aesthetics, and innovation with our premium paint solutions. Find the right paint for your project today!',
} = Astro.props;
---

<section class="cta-band section--sm" aria-labelledby="cta-band-title">
  <div class="container">
    <div class="cta-band__card" data-reveal>
      <Image src={mark} alt="" width={96} height={96} class="cta-band__mark" />
      <div class="cta-band__text">
        <h2 class="t-h2" id="cta-band-title">{title}</h2>
        <p>{body}</p>
      </div>
      <div class="cta-band__actions">
        <button type="button" class="btn btn--dark" data-open-dialog="dialog-advice">Get Expert Advice <Icon name="arrow-right" /></button>
        <a class="btn btn--white" href="/find-a-store-near-you/"><Icon name="map-pin" /> Find a Store</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band__card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--s-6);
    align-items: center;
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    border-radius: var(--r-xl);
    background: var(--orange-500);
    color: var(--ink-deep);
  }
  .cta-band__card::after {
    content: '';
    position: absolute;
    right: -8%;
    top: -60%;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 56px solid rgb(255 255 255 / 0.12);
    pointer-events: none;
  }
  .cta-band__card :global(.cta-band__mark) { width: 72px; height: 72px; padding: 10px; border-radius: 50%; background: var(--white); }
  .cta-band__text { display: grid; gap: var(--s-3); max-width: 40rem; }
  .cta-band__text h2 { font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.4rem); }
  .cta-band__text p { color: rgb(27 23 20 / 0.82); font-size: 1.0625rem; }
  .cta-band__actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .cta-band :global(:focus-visible) { outline-color: var(--ink-deep); }
  @media (max-width: 960px) {
    .cta-band__card { grid-template-columns: minmax(0, 1fr); }
    .cta-band__card :global(.cta-band__mark) { width: 56px; height: 56px; }
  }
  @media (max-width: 480px) {
    .cta-band__card { gap: var(--s-5); padding: var(--s-6) var(--s-5); }
    .cta-band__actions .btn { flex: 1 1 100%; }
  }
</style>
