---
// Interactive room painter. The room overlays have their walls cut out, so the
// paint layer only ever shows on wall regions; per-room lighting maps
// (scripts/generate-lightmaps.py) restore shadows and daylight on top of the paint.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { strips, families, familySwatch, rooms, findShade, DEFAULT_SHADE, shadeCount, type FamilyId } from '@/data/colours';

interface Props {
  variant?: 'compact' | 'full';
  initialShade?: string;
  initialRoom?: string;
  id?: string;
  headingLevel?: 'h2' | 'h3';
}
const { variant = 'compact', initialShade = DEFAULT_SHADE, initialRoom = 'living-room', id = 'viz', headingLevel = 'h2' } = Astro.props;
const H = headingLevel;

const maps = import.meta.glob<{ default: ImageMetadata }>('@/assets/rooms/light/*.png', { eager: true });
const mapFor = (room: string, kind: 'shade' | 'light') =>
  Object.entries(maps).find(([p]) => p.endsWith(`/${room}-${kind}.png`))?.[1].default;
const ROOMS_WITHOUT_DAYLIGHT = new Set(['apartment', 'house']);

const roomData = await Promise.all(
  rooms.map(async (r) => {
    const w = Math.min(1280, r.image.width);
    const overlay = await getImage({ src: r.image, width: w, format: 'webp', quality: 80 });
    const thumb = await getImage({ src: r.image, width: 240, format: 'webp', quality: 70 });
    const shadeMap = mapFor(r.id === 'bed-room' ? 'bedroom' : r.id, 'shade');
    const lightMap = ROOMS_WITHOUT_DAYLIGHT.has(r.id) ? undefined : mapFor(r.id === 'bed-room' ? 'bedroom' : r.id, 'light');
    const shade = shadeMap ? await getImage({ src: shadeMap, width: w, format: 'webp', quality: 72 }) : undefined;
    const light = lightMap ? await getImage({ src: lightMap, width: w, format: 'webp', quality: 72 }) : undefined;
    return {
      ...r,
      src: overlay.src,
      w: Number(overlay.attributes.width ?? w),
      h: Number(overlay.attributes.height ?? Math.round((r.image.height * w) / r.image.width)),
      thumb: thumb.src,
      shade: shade?.src ?? '',
      light: light?.src ?? '',
    };
  }),
);
const room = roomData.find((r) => r.id === initialRoom) ?? roomData[0];
const shade = findShade(initialShade) ?? findShade(DEFAULT_SHADE)!;
const initialFamily: FamilyId = shade.family;
const familyCounts = Object.fromEntries(
  families.map((f) => [f.id, strips.filter((s) => s.family === f.id).reduce((n, s) => n + s.shades.length, 0)]),
);
const visible = strips.filter((s) => s.family === initialFamily);
const label = (s: { code: string; name?: string }) => (s.name ? `${s.name} · ${s.code}` : s.code);
const ink = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  return 0.299 * r + 0.587 * g + 0.114 * b > 150 ? 'dark' : 'light';
};
---

<div
  class:list={['viz', `viz--${variant}`]}
  id={id}
  data-viz
  data-variant={variant}
  data-initial={shade.code}
  data-total={shadeCount}
>
  <div class="viz__top">
  {Astro.slots.has('intro') && <div class="viz__intro"><slot name="intro" /></div>}
  <ol class="steps" aria-label="How the visualizer works" data-steps>
    <li data-step="1" data-state="done">
      <span class="steps__num" aria-hidden="true"><span>1</span><Icon name="check" /></span>
      <span class="steps__text"><span class="sr-only">Step 1: </span>Choose a room</span>
    </li>
    <li data-step="2" data-state="current" aria-current="step">
      <span class="steps__num" aria-hidden="true"><span>2</span><Icon name="check" /></span>
      <span class="steps__text"><span class="sr-only">Step 2: </span>Pick a colour</span>
    </li>
    <li data-step="3" data-state="todo">
      <span class="steps__num" aria-hidden="true"><span>3</span><Icon name="check" /></span>
      <span class="steps__text"><span class="sr-only">Step 3: </span>See your walls transform</span>
    </li>
  </ol>
  </div>

  <div class="viz__grid" data-float-avoid>
    <div class="viz__left">
      <div class="block-head">
        <p class="kicker"><span>01</span> Choose a room</p>
        <p class="block-head__meta">{roomData.length} rooms</p>
      </div>
      <div class="rooms" role="radiogroup" aria-label="Room" data-rooms style={`--wall-a:${shade.hex}`}>
        {roomData.map((r) => (
          <button
            type="button"
            role="radio"
            class="room"
            aria-checked={r.id === room.id ? 'true' : 'false'}
            tabindex={r.id === room.id ? 0 : -1}
            data-room={r.id}
            data-src={r.src}
            data-shade={r.shade}
            data-light={r.light}
            data-w={r.w}
            data-h={r.h}
          >
            <span class="room__thumb"><img src={r.thumb} alt="" width="120" height="80" loading="lazy" decoding="async" /></span>
            <span class="room__label">{r.label}</span>
          </button>
        ))}
      </div>

      <figure class="stage" data-stage style={`--wall-a:${shade.hex};--wall-b:${shade.hex};--split:50%`} aria-label="Room preview">
        <div class="stage__frame">
          <div class="stage__paint stage__paint--a" aria-hidden="true"></div>
          <div class="stage__paint stage__paint--b" aria-hidden="true"></div>
          {room.shade && <img class="stage__shade" src={room.shade} alt="" aria-hidden="true" width={room.w} height={room.h} data-layer="shade" decoding="async" loading={variant === 'full' ? 'eager' : 'lazy'} />}
          <img class="stage__light" src={room.light || undefined} alt="" aria-hidden="true" width={room.w} height={room.h} data-layer="light" decoding="async" hidden={!room.light} loading={variant === 'full' ? 'eager' : 'lazy'} />
          <img
            class="stage__room"
            src={room.src}
            width={room.w}
            height={room.h}
            alt={`${room.label} with walls painted in ${label(shade)}`}
            data-layer="room"
            decoding="async"
            loading={variant === 'full' ? 'eager' : 'lazy'}
            fetchpriority={variant === 'full' ? 'high' : undefined}
          />

          <span class="stage__tag"><span class="stage__dot"></span>Your room preview</span>
          <span class="stage__code" data-stage-code><span class="stage__code-chip"></span><span data-stage-code-text>{shade.code}</span></span>

          <div class="stage__compare" aria-hidden="true">
            <span class="stage__ab stage__ab--a">A · <span data-label-a>{shade.code}</span></span>
            <span class="stage__ab stage__ab--b">B · <span data-label-b>{shade.code}</span></span>
            <span class="stage__divider"><span class="stage__knob"><Icon name="chevron-left" /><Icon name="chevron-right" /></span></span>
          </div>
          <label class="sr-only" for={`${id}-split`}>Comparison divider position</label>
          <input class="stage__range" id={`${id}-split`} type="range" min="0" max="100" value="50" data-split tabindex="-1" />

          <p class="stage__hint" data-hint>
            <span class="stage__hand"><Icon name="hand" /></span>
            Tap any shade to paint your walls
            <Icon name="arrow-right" class="stage__hint-arrow" />
          </p>
        </div>
      </figure>

      <div class="current" data-current>
        <span class="current__chip" data-current-chip style={`background:${shade.hex}`}></span>
        <div class="current__text">
          <p class="current__label" data-current-label>Current wall colour</p>
          <p class="current__name" aria-live="polite">
            <strong data-current-name>{shade.name ?? shade.code}</strong><span data-current-code-sep hidden={!shade.name}> · </span><span data-current-code>{shade.name ? shade.code : ''}</span>
          </p>
          <p class="current__meta" data-current-rgb>RGB {shade.rgb.replaceAll(',', ', ')}</p>
        </div>
        <div class="current__compare" data-compare-summary hidden>
          <span class="current__pair"><span class="current__mini" data-mini-a></span><strong>A</strong> <span data-mini-a-code></span></span>
          <button type="button" class="current__swap" data-swap aria-label="Swap A and B"><Icon name="arrow-left" /><Icon name="arrow-right" /></button>
          <span class="current__pair"><span class="current__mini" data-mini-b></span><strong>B</strong> <span data-mini-b-code></span></span>
        </div>
        <div class="current__actions">
          <button type="button" class="act" data-compare aria-pressed="false"><Icon name="layers" /><span data-compare-label>Compare</span></button>
          <button type="button" class="act" data-copy><Icon name="copy" /><span data-copy-label>Copy code</span></button>
          <button type="button" class="act" data-reset><Icon name="refresh" /><span>Reset colour</span></button>
        </div>
      </div>
      <p class="viz__note"><Icon name="info" /> On-screen colours are a preview and may differ from the paint on your wall. Please check a shade card or sample at your nearest Retina store before you buy.</p>
    </div>

    <div class="panel" data-panel>
      <div class="panel__head">
        <p class="kicker"><span>02</span> Pick a shade</p>
        <H class="panel__title">Choose Your Wall Colour</H>
        <p class="panel__lead">Select a colour family, then tap any shade to see it on your walls.</p>
      </div>

      <div class="search">
        <label for={`${id}-search`} class="sr-only">Search shades by name or code</label>
        <Icon name="search" />
        <input id={`${id}-search`} type="search" placeholder="Search shades by name or code" autocomplete="off" spellcheck="false" data-search />
        <button type="button" class="search__clear" data-clear hidden aria-label="Clear search"><Icon name="close" /></button>
      </div>

      <div class="families" role="radiogroup" aria-label="Colour family" data-families>
        {families.map((f) => {
          const fs = strips.filter((s) => s.family === f.id && s.shades.length >= 5);
          const mid = fs[Math.floor(fs.length / 2)].shades;
          const ring = `conic-gradient(${familySwatch(f.id)} 0 33%, ${mid[2].hex} 0 66%, ${mid[4].hex} 0)`;
          return (
            <button
              type="button"
              role="radio"
              class="family"
              aria-checked={f.id === initialFamily ? 'true' : 'false'}
              tabindex={f.id === initialFamily ? 0 : -1}
              data-family={f.id}
            >
              <span class="family__dot" style={`background:${ring}`}><Icon name="check" class="family__check" /></span>
              <span class="family__name">{f.label}</span>
              <span class="sr-only">, {familyCounts[f.id]} shades</span>
            </button>
          );
        })}
      </div>

      <div class="deck-head">
        <div class="tones" role="radiogroup" aria-label="Shade depth" data-tones>
          {[['all', 'All'], ['light', 'Light'], ['medium', 'Medium'], ['dark', 'Dark']].map(([v, l], i) => (
            <button type="button" role="radio" class="tone" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tone={v}>
              {v !== 'all' && <span class:list={['tone__dot', `tone__dot--${v}`]}></span>}{l}
            </button>
          ))}
        </div>
        <p class="deck-head__count" aria-live="polite" data-count>{familyCounts[initialFamily]} shades available</p>
      </div>

      <div class="deck-wrap" data-deck-wrap>
        <div class="deck" role="radiogroup" aria-label="Shades" data-deck>
          {visible.map((s) => (
            <div class="deck__row" role="presentation">
              {s.shades.map((sh) => (
                <button
                  type="button"
                  role="radio"
                  class="swatch"
                  style={`--c:${sh.hex}`}
                  data-code={sh.code}
                  data-ink={ink(sh.hex)}
                  aria-checked={sh.code === shade.code ? 'true' : 'false'}
                  tabindex={sh.code === shade.code ? 0 : -1}
                  aria-label={`${sh.name ? `${sh.name}, ` : ''}${sh.code}`}
                  title={sh.name ? `${sh.name} · ${sh.code}` : sh.code}
                >
                  <span class="swatch__code" aria-hidden="true">{sh.code}</span>
                  <Icon name="check" class="swatch__check" />
                </button>
              ))}
            </div>
          ))}
        </div>
        <p class="deck-more" data-more aria-hidden="true"><Icon name="chevron-down" /> Scroll for more shades</p>
      </div>
    </div>
  </div>
</div>

<script>
  import { initVisualizers } from '@/scripts/visualizer';
  initVisualizers();
</script>

<style>
  .viz { --accent-ring: var(--orange-500); display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.25rem, 1rem + 1vw, 2rem); }

  /* ---------- Intro + steps ---------- */
  .viz__top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--s-5) var(--s-8); }
  .viz__intro { flex: 1 1 26rem; min-width: 0; }
  .steps { display: flex; align-items: center; margin: 0; padding: 0; list-style: none; }
  .steps li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.9rem 0.45rem 0.45rem;
    border-radius: var(--r-pill);
    border: 1.5px solid transparent;
    transition: border-color var(--t-base), background-color var(--t-base), box-shadow var(--t-base);
  }
  .steps li + li { margin-left: 2.25rem; }
  .steps li + li::before {
    content: '';
    position: absolute;
    right: calc(100% + 0.4rem);
    top: 50%;
    width: 1.45rem;
    height: 2px;
    border-radius: 2px;
    background: var(--line-strong);
  }
  .steps li[data-state='done'] + li::before { background: var(--ink-deep); }
  .steps__num {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-ui);
    color: var(--ink-soft);
    transition: all var(--t-base) var(--ease-out);
  }
  .steps__num :global(.icon) { position: absolute; width: 1rem; height: 1rem; opacity: 0; transform: scale(0.5); transition: all var(--t-base) var(--ease-out); stroke-width: 2.5; }
  .steps__text { display: grid; line-height: 1.25; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-ui); color: var(--ink-deep); white-space: nowrap; }
  .steps__k { font-family: var(--font-display); font-size: var(--fs-caption); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--ink-mute); }
  .steps li[data-state='current'] { border-color: var(--orange-500); background: var(--orange-50); box-shadow: 0 0 0 3px rgb(242 128 32 / 0.12); }
  .steps li[data-state='current'] .steps__num { border-color: var(--orange-500); background: var(--orange-500); color: var(--ink-deep); }
  .steps li[data-state='current'] .steps__k { color: var(--orange-700); }
  .steps li[data-state='done'] .steps__num { border-color: var(--ink-deep); background: var(--ink-deep); color: var(--white); }
  .steps li[data-state='done'] .steps__num > span { opacity: 0; }
  .steps li[data-state='done'] .steps__num :global(.icon) { opacity: 1; transform: none; }
  .steps li[data-state='todo'] .steps__text { color: var(--ink-soft); }

  /* ---------- Layout ---------- */
  .viz__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: start;
  }
  .viz__left { display: grid; gap: var(--s-4); position: sticky; top: calc(var(--header-h) + 1rem); }
  .block-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); }
  .block-head__meta { font-size: var(--fs-label); color: var(--ink-soft); }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-deep);
  }
  .kicker span { color: var(--orange-700); }
  .kicker span::after { content: ' —'; color: var(--ink-mute); }

  /* ---------- Rooms ---------- */
  .rooms { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: var(--s-2); }
  .room {
    display: grid;
    gap: 0.35rem;
    padding: 0.35rem 0.35rem 0.5rem;
    border: 1.5px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--white);
    color: var(--ink-soft);
    text-align: center;
    transition: border-color var(--t-fast), background-color var(--t-fast), color var(--t-fast), transform var(--t-fast);
  }
  .room:hover { border-color: var(--ink-mute); color: var(--ink-deep); }
  .room[aria-checked='true'] { border-color: var(--orange-500); background: var(--orange-50); color: var(--ink-deep); box-shadow: 0 0 0 1px var(--orange-500); }
  .room__thumb { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 6px; background: var(--wall-a); transition: background-color 500ms var(--ease-in-out); }
  .room__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .room__label { font-size: var(--fs-caption); font-weight: 600; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .room[aria-checked='true'] .room__label { font-weight: 600; }

  /* ---------- Stage ---------- */
  .stage { margin: 0; }
  .stage__frame {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--sand);
    box-shadow: var(--shadow-md);
    isolation: isolate;
  }
  .stage__paint, .stage__shade, .stage__light, .stage__room { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stage__shade, .stage__light, .stage__room { object-fit: cover; pointer-events: none; }
  .stage__paint { transition: background-color 600ms var(--ease-in-out); }
  .stage__paint--a { background: var(--wall-a); }
  .stage__paint--b { background: var(--wall-b); clip-path: inset(0 0 0 var(--split)); visibility: hidden; }
  .stage__shade { mix-blend-mode: multiply; }
  .stage__light { mix-blend-mode: screen; }
  .stage[data-loading] .stage__room { opacity: 0.6; transition: opacity var(--t-base); }

  .stage__tag, .stage__code {
    position: absolute;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-xs);
    font-family: var(--font-display);
    color: var(--ink-deep);
  }
  .stage__tag { font-family: var(--font-display); top: var(--s-4); left: var(--s-4); font-size: var(--fs-caption); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .stage__dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--orange-500); box-shadow: 0 0 0 3px rgb(242 128 32 / 0.25); }
  .stage__code { left: var(--s-4); bottom: var(--s-4); font-size: var(--fs-ui); font-weight: 600; padding-left: 0.4rem; }
  .stage__code-chip { width: 1.35rem; height: 1.35rem; border-radius: 50%; background: var(--wall-a); box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1); transition: background-color 600ms var(--ease-in-out); }

  .stage__hint {
    position: absolute;
    z-index: 3;
    right: var(--s-4);
    bottom: var(--s-4);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.9rem 0.55rem 0.55rem;
    border-radius: var(--r-pill);
    background: var(--ink-deep);
    color: var(--white);
    font-family: var(--font-display);
    font-size: var(--fs-ui);
    font-weight: 600;
    box-shadow: 0 12px 28px -12px rgb(0 0 0 / 0.6);
    transition: opacity var(--t-base), transform var(--t-base) var(--ease-out);
  }
  .stage__hand { display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: var(--orange-500); color: var(--ink-deep); }
  .stage__hand :global(.icon) { width: 1.1rem; height: 1.1rem; }
  .stage__hint :global(.stage__hint-arrow) { width: 1rem; height: 1rem; color: var(--orange-300); }
  .viz[data-touched] .stage__hint { opacity: 0; transform: translateY(8px); pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .stage__hand { animation: tap 1.4s var(--ease-out) 0.8s 3; }
    .stage__hint :global(.stage__hint-arrow) { animation: nudge 1.4s var(--ease-out) 0.8s 3; }
  }
  @keyframes tap { 0%, 100% { transform: none; } 35% { transform: translateY(2px) scale(0.86); } 60% { transform: none; } }
  @keyframes nudge { 0%, 100% { transform: none; } 40% { transform: translateX(4px); } }

  /* Compare mode */
  .stage__compare, .stage__range { display: none; }
  .viz[data-compare] .stage__paint--b { visibility: visible; }
  .viz[data-compare] .stage__compare { display: block; position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .viz[data-compare] .stage__code, .viz[data-compare] .stage__hint, .viz[data-compare] .stage__tag { display: none; }
  .stage__ab { position: absolute; top: var(--s-4); padding: 0.35rem 0.7rem; border-radius: var(--r-pill); background: var(--ink-deep); color: var(--white); font-family: var(--font-display); font-size: var(--fs-label); font-weight: 600; }
  .stage__ab--a { left: var(--s-4); }
  .stage__ab--b { right: var(--s-4); }
  .stage__divider { position: absolute; top: 0; bottom: 0; left: var(--split); width: 3px; margin-left: -1.5px; background: var(--white); box-shadow: 0 0 12px rgb(0 0 0 / 0.35); }
  .stage__knob { position: absolute; top: 50%; left: 50%; display: flex; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; margin: -1.375rem 0 0 -1.375rem; border-radius: 50%; background: var(--white); color: var(--ink-deep); box-shadow: var(--shadow-md); }
  .stage__knob :global(.icon) { width: 0.9rem; height: 0.9rem; margin: 0 -2px; }
  .viz[data-compare] .stage__range {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .viz[data-compare] .stage__range:focus-visible + .stage__hint, .viz[data-compare] .stage__frame:has(.stage__range:focus-visible) .stage__knob { outline: 3px solid var(--orange-500); outline-offset: 2px; }

  /* ---------- Current colour ---------- */
  .current {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--s-4);
    align-items: center;
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-3);
