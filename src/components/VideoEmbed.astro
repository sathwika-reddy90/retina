---
// Lightweight YouTube facade: shows a poster and only loads the player
// (from youtube-nocookie.com) when the visitor presses play.
import Icon from './Icon.astro';
interface Props {
  id: string;
  title: string;
  caption?: string;
}
const { id, title, caption } = Astro.props;
---

<figure class="video">
  <div class="video__frame" data-yt={id} data-yt-title={title}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
    <button type="button" class="video__play" aria-label={`Play video: ${title}`}>
      <span><Icon name="play" /></span>
    </button>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
  <noscript><a href={`https://www.youtube.com/watch?v=${id}`}>Watch “{title}” on YouTube</a></noscript>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((frame) => {
    frame.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = frame.dataset.ytTitle ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video { display: grid; gap: var(--s-3); }
  .video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--ink-deep);
  }
  .video__frame img, .video__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .video__frame img { transition: transform var(--t-slow) var(--ease-out), opacity var(--t-base); opacity: 0.92; }
  .video__frame:hover img { transform: scale(1.03); opacity: 1; }
  .video__play { position: absolute; inset: 0; display: grid; place-items: center; border: 0; background: linear-gradient(transparent 40%, rgb(0 0 0 / 0.35)); }
  .video__play span {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--orange-500);
    color: var(--ink-deep);
    box-shadow: 0 12px 30px -8px rgb(0 0 0 / 0.5);
    transition: transform var(--t-base) var(--ease-out);
  }
  .video__play :global(.icon) { width: 1.75rem; height: 1.75rem; fill: currentColor; margin-left: 4px; }
  .video__play:hover span { transform: scale(1.08); }
  .video figcaption { font-size: var(--fs-small); color: var(--ink-soft); }
</style>
