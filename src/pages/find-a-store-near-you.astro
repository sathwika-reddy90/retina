---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import storeData from '@/data/stores.json';
import { franchisePhone } from '@/data/site';

type Store = { village: string; store: string; phone?: string; storeCode?: string };
const data = storeData as Record<string, Record<string, Store[]>>;
const states = Object.keys(data);
const total = states.reduce((n, s) => n + Object.values(data[s]).reduce((m, d) => m + d.length, 0), 0);
const districtCount = states.reduce((n, s) => n + Object.keys(data[s]).length, 0);
---

<BaseLayout
  title="Find A Store Near You"
  description="Locate your nearest Retina store for top-quality paints and expert advice. Retina stores across Telangana and Andhra Pradesh."
>
  <PageHeader
    eyebrow="Store locator"
    title="Find a Retina Store Near You!"
    lead="Locate your nearest Retina store for top-quality paints and expert advice!"
    crumbs={[{ label: 'Find A Store Near You' }]}
  />

  <section class="section locator" aria-label="Store finder">
    <div class="container">
      <form class="finder" data-finder aria-describedby="finder-summary">
        <div class="field">
          <label for="state">State</label>
          <select id="state" name="state" data-state>
            <option value="">--Select State--</option>
            {states.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="district">District</label>
          <select id="district" name="district" data-district disabled>
            <option value="">--Select District--</option>
          </select>
        </div>
        <p class="finder__summary" id="finder-summary">
          <Icon name="store" />
          <span><strong>{total} stores</strong> across {districtCount} districts in {states.join(' and ')}.</span>
        </p>
      </form>

      <div class="results" data-results>
        <div class="results__intro" data-intro>
          <h2 class="t-h3">Browse by district</h2>
          {states.map((s) => (
            <div class="results__state">
              <h3 class="results__state-name">{s}</h3>
              <ul role="list" class="results__districts">
                {Object.entries(data[s]).map(([d, list]) => (
                  <li>
                    <button type="button" class="tag results__pick" data-pick-state={s} data-pick-district={d}>
                      {d} <span>{list.length}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div data-list hidden>
          <div class="results__head">
            <h2 class="t-h3" data-heading tabindex="-1"></h2>
            <button type="button" class="link-arrow" data-reset><Icon name="arrow-left" /> All districts</button>
          </div>
          <ul role="list" class="stores" data-stores></ul>
        </div>
      </div>

      <aside class="locator__help">
        <Icon name="phone" />
        <p>Can’t find a store near you? Call <a href={`tel:${franchisePhone}`}>{franchisePhone}</a> or <button type="button" data-open-dialog="dialog-advice">request a callback</button>.</p>
      </aside>
    </div>
  </section>

  <script type="application/json" id="store-data" set:html={JSON.stringify(data)} />
</BaseLayout>

<script>
  type Store = { village: string; store: string; phone?: string; storeCode?: string };
  const data = JSON.parse(document.getElementById('store-data')!.textContent!) as Record<string, Record<string, Store[]>>;
  const state = document.querySelector<HTMLSelectElement>('[data-state]')!;
  const district = document.querySelector<HTMLSelectElement>('[data-district]')!;
  const intro = document.querySelector<HTMLElement>('[data-intro]')!;
  const listWrap = document.querySelector<HTMLElement>('[data-list]')!;
  const heading = document.querySelector<HTMLElement>('[data-heading]')!;
  const stores = document.querySelector<HTMLElement>('[data-stores]')!;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const maps = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
  const icon = (d: string) => `<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
  const PIN = '<path d="M12 21s-7-6.1-7-11.5a7 7 0 1 1 14 0C19 14.9 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>';
  const PHONE = '<path d="M5 4h3.2l1.6 4-2 1.3a11 11 0 0 0 6.9 6.9l1.3-2 4 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16 16 0 0 1 3.4 5.7 1.6 1.6 0 0 1 5 4Z"/>';
  const NAV = '<path d="m3 11 18-8-8 18-2-8-8-2Z"/>';

  const fillDistricts = (s: string) => {
    district.replaceChildren(new Option('--Select District--', ''));
    district.disabled = !s;
    if (s) Object.keys(data[s]).forEach((d) => district.add(new Option(d, d)));
  };

  const show = (s: string, d: string, focus = false) => {
    if (!s || !d) {
      intro.hidden = false;
      listWrap.hidden = true;
      return;
    }
    const list = data[s][d] ?? [];
    heading.textContent = `${d} Stores`;
    stores.innerHTML = list
      .map(
        (x) => `<li class="store">
          <div class="store__top">
            <h3 class="store__name">${esc(x.village)}</h3>
            ${x.storeCode ? `<span class="store__code">${esc(x.storeCode)}</span>` : ''}
          </div>
          <p class="store__addr">${icon(PIN)}<span>${esc(x.store)}</span></p>
          <div class="store__actions">
            ${x.phone ? `<a href="tel:${esc(x.phone)}" class="store__btn">${icon(PHONE)}${esc(x.phone)}</a>` : ''}
            <a href="${maps(`${x.store}, ${s}`)}" target="_blank" rel="noopener" class="store__btn">${icon(NAV)}Directions<span class="sr-only"> (opens Google Maps in a new tab)</span></a>
          </div>
        </li>`,
      )
      .join('');
    intro.hidden = true;
    listWrap.hidden = false;
    if (focus) heading.focus();
  };

  state.addEventListener('change', () => {
    fillDistricts(state.value);
    show('', '');
  });
  district.addEventListener('change', () => show(state.value, district.value));
  document.querySelectorAll<HTMLButtonElement>('[data-pick-state]').forEach((b) =>
    b.addEventListener('click', () => {
      state.value = b.dataset.pickState!;
      fillDistricts(state.value);
      district.value = b.dataset.pickDistrict!;
      show(state.value, district.value, true);
    }),
  );
  document.querySelector('[data-reset]')!.addEventListener('click', () => {
    state.value = '';
    fillDistricts('');
    show('', '');
    state.focus();
  });
</script>

<style>
  .finder {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--s-5);
    align-items: end;
    padding: var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }
  .finder select:disabled { background-color: var(--cream); color: var(--ink-mute); cursor: not-allowed; }
  .finder__summary { display: flex; gap: var(--s-3); align-items: center; padding: var(--s-3) var(--s-4); min-height: 3rem; border-radius: var(--r-sm); background: var(--orange-50); font-size: var(--fs-small); color: var(--ink-soft); }
  .finder__summary :global(.icon) { color: var(--orange-600); }
  .finder__summary strong { color: var(--ink-deep); }
  @media (max-width: 860px) { .finder { grid-template-columns: minmax(0, 1fr); } }

  .results { margin-top: var(--s-8); }
  .results__intro { display: grid; gap: var(--s-6); }
  .results__state { display: grid; gap: var(--s-3); }
  .results__state-name { font-family: var(--font-display); font-size: var(--fs-label); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--ink-soft); }
  .results__districts { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; }
  .results__pick { min-height: 40px; padding: 0.45rem 0.55rem 0.45rem 0.95rem; cursor: pointer; font-size: var(--fs-ui); color: var(--ink); background: var(--white); transition: all var(--t-fast); }
  .results__pick span { display: grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 0.3rem; border-radius: var(--r-pill); background: var(--orange-100); color: var(--orange-800); font-size: var(--fs-caption); font-weight: 600; }
  .results__pick:hover { border-color: var(--orange-300); background: var(--orange-50); }
  .results__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3); margin-bottom: var(--s-5); }
  .results__head h2:focus { outline: none; }
  .results__head .link-arrow { border: 0; background: none; padding: 0; }

  .stores { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  @media (max-width: 1000px) { .stores { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .stores { grid-template-columns: minmax(0, 1fr); } }
  .stores :global(.store) { display: grid; gap: var(--s-3); align-content: start; padding: var(--s-5); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--white); transition: border-color var(--t-base), box-shadow var(--t-base); }
  .stores :global(.store:hover) { border-color: var(--orange-200); box-shadow: var(--shadow-sm); }
  .stores :global(.store__top) { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
  .stores :global(.store__name) { font-size: 1.15rem; color: var(--ink-deep); }
  .stores :global(.store__code) { padding: 0.15rem 0.55rem; border-radius: var(--r-pill); background: var(--cream); border: 1px solid var(--line); font-size: var(--fs-caption); font-weight: 600; color: var(--ink-soft); }
  .stores :global(.store__addr) { display: flex; gap: var(--s-2); font-size: var(--fs-small); line-height: 1.55; color: var(--ink-soft); }
  .stores :global(.store__addr .icon) { width: 1.05rem; height: 1.05rem; margin-top: 0.2rem; color: var(--orange-600); }
  .stores :global(.store__actions) { display: flex; flex-wrap: wrap; gap: var(--s-2); padding-top: var(--s-3); border-top: 1px solid var(--line); }
  .stores :global(.store__btn) { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 40px; padding: 0.4rem 0.85rem; border: 1px solid var(--line-strong); border-radius: var(--r-pill); font-size: var(--fs-ui); font-weight: 600; color: var(--ink-deep); text-decoration: none; }
  .stores :global(.store__btn:hover) { border-color: var(--ink-deep); }
  .stores :global(.store__btn .icon) { width: 1rem; height: 1rem; color: var(--orange-600); }

  .locator__help { display: flex; gap: var(--s-3); align-items: center; margin-top: var(--s-8); padding: var(--s-5); border-radius: var(--r-md); background: var(--cream); color: var(--ink-soft); }
  .locator__help :global(.icon) { color: var(--orange-600); }
  .locator__help a, .locator__help button { color: var(--orange-700); font-weight: 600; border: 0; background: none; padding: 0; text-decoration: underline; text-underline-offset: 0.2em; }
</style>
