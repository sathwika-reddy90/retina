---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import EnquiryForm from '@/components/EnquiryForm.astro';
import Icon from '@/components/Icon.astro';
import { company, contactPageAddress, emails, phones, franchisePhone, mapsQuery, whatsappUrl } from '@/data/site';

const tel = (p: string) => `tel:${p.replace(/-/g, '')}`;
const channels = [
  { icon: 'mail', label: 'General enquiries', value: emails.info, href: `mailto:${emails.info}` },
  { icon: 'store', label: 'Franchise', value: emails.franchise, href: `mailto:${emails.franchise}` },
  { icon: 'briefcase', label: 'Careers', value: emails.careers, href: `mailto:${emails.careers}` },
  { icon: 'users', label: 'Investor grievances', value: emails.investors, href: `mailto:${emails.investors}` },
];
---

<BaseLayout title="Contact us" description={`Contact ${company.name}: registered and corporate office at IDA Cherlapally, Hyderabad. Phone ${phones.join(', ')}, email ${emails.info}.`}>
  <PageHeader
    eyebrow="Contact"
    title="Contact us"
    lead="Questions about a product, a project or a partnership? Reach the right team directly, or send us a message."
    crumbs={[{ label: 'Contact us' }]}
  />

  <section class="section contact">
    <div class="container contact__grid">
      <div class="contact__info">
        <article class="office" data-reveal>
          <h2 class="office__name">RETINA PAINTS LIMITED.</h2>
          <p class="office__label">{contactPageAddress.label}:</p>
          <address>{contactPageAddress.lines.map((l) => <>{l}<br /></>)}</address>
          <a class="link-arrow" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}`} target="_blank" rel="noopener">
            Get directions <Icon name="arrow-up-right" /><span class="sr-only"> (opens Google Maps in a new tab)</span>
          </a>
        </article>

        <div class="contact__phones" data-reveal>
          <h2 class="contact__label">Phone</h2>
          <ul role="list">
            {phones.map((p) => <li><a href={tel(p)}><Icon name="phone" />{p}</a></li>)}
            <li><a href={`tel:${franchisePhone}`}><Icon name="store" />{franchisePhone} <span>Franchise</span></a></li>
            <li><a href={whatsappUrl} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp <span>{franchisePhone}</span></a></li>
          </ul>
        </div>

        <div class="contact__emails" data-reveal>
          <h2 class="contact__label">E-mail</h2>
          <ul role="list">
            {channels.map((c) => (
              <li>
                <span class="contact__ch-icon"><Icon name={c.icon} /></span>
                <span><span class="contact__ch-label">{c.label}</span><a href={c.href}>{c.value}</a></span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="contact__form" data-reveal>
        <h2 class="t-h3">Contact Us</h2>
        <p class="t-muted">Send us a message and our team will get back to you.</p>
        <EnquiryForm type="contact" id="contact-page-form" />
      </div>
    </div>
  </section>

  <section class="map" aria-label="Map">
    <iframe
      title="Map showing Retina Paints Limited, IDA Cherlapally, Hyderabad"
      src={`https://www.google.com/maps?q=${encodeURIComponent(mapsQuery)}&output=embed`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </section>
</BaseLayout>

<style>
  .contact__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: start; }
  .contact__info { display: grid; gap: var(--s-6); }
  .office { display: grid; gap: var(--s-3); justify-items: start; padding: var(--s-6); border-radius: var(--r-lg); background: var(--orange-100); }
  .office__name { font-size: var(--fs-h4); letter-spacing: 0.02em; }
  .office__label { font-weight: 600; color: var(--ink-deep); }
  .office address { font-style: normal; color: var(--ink-soft); line-height: 1.7; }
  .contact__label { margin-bottom: var(--s-3); font-size: var(--fs-label); font-weight: 700; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--ink-soft); }
  .contact__phones ul, .contact__emails ul { display: grid; gap: var(--s-2); margin: 0; padding: 0; list-style: none; }
  .contact__phones a { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; color: var(--ink-deep); text-decoration: none; }
  .contact__phones a:hover { color: var(--orange-700); }
  .contact__phones a span { font-family: var(--font-body); font-size: 0.8125rem; font-weight: 500; color: var(--ink-soft); }
  .contact__phones :global(.icon) { color: var(--orange-600); }
  .contact__emails li { display: flex; gap: var(--s-3); align-items: center; padding: var(--s-3) 0; border-top: 1px solid var(--line); }
  .contact__ch-icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--cream); color: var(--orange-700); flex: none; }
  .contact__ch-label { display: block; font-size: 0.8125rem; color: var(--ink-soft); }
  .contact__emails a { color: var(--ink-deep); font-weight: 600; overflow-wrap: anywhere; }
  .contact__emails a:hover { color: var(--orange-700); }
  .contact__form { display: grid; gap: var(--s-3); padding: clamp(1.5rem, 1rem + 2vw, 2.75rem); border: 1px solid var(--line); border-radius: var(--r-xl); background: var(--white); box-shadow: var(--shadow-md); }
  .contact__form :global(form) { margin-top: var(--s-4); }
  @media (max-width: 900px) { .contact__grid { grid-template-columns: minmax(0, 1fr); } }
  .map iframe { width: 100%; height: clamp(18rem, 12rem + 20vw, 28rem); border: 0; filter: grayscale(0.35) contrast(1.02); }
</style>
