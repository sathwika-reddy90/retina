---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Visualizer from '@/components/Visualizer.astro';
import VideoEmbed from '@/components/VideoEmbed.astro';
import Modal from '@/components/Modal.astro';
import HeroCarousel from '@/components/home/HeroCarousel.astro';
import CategoryGrid from '@/components/home/CategoryGrid.astro';
import ColourCarousel from '@/components/home/ColourCarousel.astro';
import FeaturedProducts from '@/components/home/FeaturedProducts.astro';
import BeyondColours from '@/components/home/BeyondColours.astro';
import ColourTools from '@/components/home/ColourTools.astro';
import DesignerCollections from '@/components/home/DesignerCollections.astro';
import OneStop from '@/components/home/OneStop.astro';
import PaintCalculator from '@/components/home/PaintCalculator.astro';
import Inspiration from '@/components/home/Inspiration.astro';
import BeforeAfter from '@/components/home/BeforeAfter.astro';
import PaintFinder from '@/components/home/PaintFinder.astro';

import exteriorHome from '@/assets/imagery/exterior-home.jpg';
import storeInterior from '@/assets/imagery/store-interior.jpg';
import officeBuilding from '@/assets/imagery/office-building.jpg';
import bseListing from '@/assets/news/bse/Retinas-Shares-got-listed-in-BSE-SME-Platform-2.jpg';
import mdPortrait from '@/assets/team/md-portrait.png';

import { company, homeStats, experience, homeVision, homeMission, franchisePhone } from '@/data/site';
import { productBySlug, type Product } from '@/data/products';
import { whyChooseUs, mdMessage } from '@/data/about';
import { storePromise, growBusiness, franchisePromo, homeFranchise } from '@/data/franchise';
import { posts, announcements, blogTitle } from '@/data/news';
import { shadeCount } from '@/data/colours';
import { docUrl } from '@/data/site';


const pick = (slugs: string[]) => slugs.map((s) => productBySlug(s)).filter((p): p is Product => Boolean(p));
const exteriorTrio = pick(['weather-expert', 'expo-ultimax', 'expo-advanced']);

// Quick access: each card opens an existing page, section, form or tool on this site.
const quickLinks = [
  { icon: 'brush', title: 'Painting Services', text: 'Need help choosing the right paint? Our experts are here to guide you!', dialog: 'dialog-advice' },
  { icon: 'sliders', title: 'Paint Cost Calculator', text: 'Get an indicative budget for your painting project.', href: '#calculator' },
  { icon: 'droplet', title: 'Waterproofing Solutions', text: 'Waterproof and damp-proof primers for exterior walls.', href: '/products/#waterproof-primers' },
  { icon: 'home', title: 'Interior Painting', text: 'Interior emulsions in matt and high-sheen finishes.', href: '/products/#interior-emulsions' },
  { icon: 'palette', title: 'Explore Colours', text: `Browse ${(Math.floor(shadeCount / 100) * 100).toLocaleString('en-IN')}+ Retina shades and preview them in a room.`, href: '/colors/' },
  { icon: 'map-pin', title: 'Find a Dealer', text: 'Locate your nearest Retina store for top-quality paints and expert advice!', href: '/find-a-store-near-you/' },
];

const credentials = [
  { icon: 'certificate', text: 'ISO 9001:2015 certified company' },
  { icon: 'trending-up', text: 'Equity shares listed on the BSE SME Platform since 3 May 2023' },
  { icon: 'factory', text: 'Operations at its own land & building, Rayaraopet near Ghatkesar, Hyderabad' },
  { icon: 'badge-check', text: 'Logo registered under the Trademarks Act, 1999' },
];
const fmtDate = (iso: string) => new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Home" description={company.intro}>
  <HeroCarousel />

  <!-- ============ QUICK ACCESS ============ -->
  <section class="quick" aria-label="Quick access">
    <div class="container">
      <ul role="list" class="quick__list" data-reveal>
        {quickLinks.map((q) => (
          <li class="quick__item">
            <span class="quick__icon"><Icon name={q.icon} /></span>
            {q.href ? (
              <a href={q.href} class="quick__title">{q.title}</a>
            ) : (
              <button type="button" class="quick__title" data-open-dialog={q.dialog}>{q.title}</button>
            )}
            <span class="quick__desc">{q.text}</span>
            <Icon name="arrow-right" class="quick__arrow" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FeaturedProducts />
  <CategoryGrid />
  <ColourCarousel />
  <BeforeAfter />

  <!-- ============ EXTERIOR PROTECTION ============ -->
  <section class="exterior on-dark" aria-labelledby="exterior-title">
    <Image src={exteriorHome} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="exterior__bg" loading="lazy" />
    <div class="container exterior__inner">
      <div class="exterior__copy" data-reveal>
        <p class="eyebrow eyebrow--light">Exterior Emulsions</p>
        <h2 class="t-h2" id="exterior-title">Shield Your Home with Long-Lasting Protection!</h2>
        <p class="exterior__lead">Beauty That Lasts, Protection That Endures. Our exterior emulsions are designed to withstand extreme weather conditions, protecting your walls from rain, UV rays, and dust.</p>
        <a class="btn" href="/products/#exterior-emulsions">Explore Exterior Paints <Icon name="arrow-right" /></a>
      </div>
      <ul role="list" class="exterior__list" data-reveal style="--reveal-delay: 120ms">
        {exteriorTrio.map((p) => (
          <li>
            <a href={p.href!} class="exterior__item">
              <Image src={p.image} alt="" width={120} height={125} class="exterior__pack" />
              <span>
                <strong>{p.name}</strong>
                <span>{p.warranty} Years Warranty</span>
              </span>
              <Icon name="arrow-right" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ COLOUR VISUALIZER ============ -->
  <section class="section viz-section" aria-labelledby="viz-title" id="visualizer">
    <div class="container">
      <div style="--viz-bg: var(--orange-50)">
        <Visualizer variant="compact" id="home-viz" initialRoom="kids-room" headingLevel="h3">
          <div class="stack viz-head" style="--stack: var(--s-3)" slot="intro">
            <p class="eyebrow">Colour Visualizer</p>
            <h2 class="t-h2" id="viz-title">See Your Walls in a New Light</h2>
            <p class="t-lead">Choose a room, pick a Retina shade and watch only the walls change, with furniture and light left as they are. <a class="link-arrow" href="/colors/">Open the full visualizer <Icon name="arrow-right" /></a></p>
          </div>
        </Visualizer>
      </div>
    </div>
  </section>

  <BeyondColours />
  <ColourTools />
  <DesignerCollections />
  <OneStop />
  <PaintCalculator />
  <Inspiration />

  <!-- ============ WHY CHOOSE US ============ -->
  <section class="section why" aria-labelledby="why-title">
    <div class="container why__grid">
      <div class="why__head" data-reveal>
        <p class="eyebrow">{whyChooseUs.eyebrow}</p>
        <h2 class="t-h2" id="why-title">{whyChooseUs.title}</h2>
        <p class="t-lead">{whyChooseUs.intro}</p>
      </div>
      <ol role="list" class="why__list" data-reveal-stagger="90">
        {whyChooseUs.items.map((item, i) => (
          <li class="why__item">
            <span class="why__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="why__icon"><Icon name={item.icon} /></span>
            <h3 class="t-h4">{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <PaintFinder />

  <!-- ============ BRAND STORY ============ -->
  <section class="section section--flush-top story" aria-labelledby="story-title">
    <div class="container story__grid">
      <div class="story__media" data-reveal>
        <Image src={bseListing} alt="Retina Paints management at the BSE on the day the company’s shares were listed" widths={[480, 800, 1024]} sizes="(max-width: 960px) 100vw, 46vw" class="story__img story__img--main" />
        <Image src={officeBuilding} alt="Retina Paints Limited building with company signage" widths={[320, 520]} sizes="(max-width: 960px) 50vw, 20vw" class="story__img story__img--small" />
        <div class="story__stat">
          <strong>{experience.value}</strong>
          <span>{experience.label}</span>
        </div>
      </div>
      <div class="story__copy" data-reveal style="--reveal-delay: 100ms">
        <p class="eyebrow">About Retina Paints</p>
        <h2 class="t-h2" id="story-title">“{company.tagline}”</h2>
        <p class="t-lead">{company.intro}</p>
        <dl class="story__vm">
          <div><dt>Our Vision</dt><dd>{homeVision}</dd></div>
          <div><dt>Our Mission</dt><dd>{homeMission}</dd></div>
        </dl>
        <dl class="story__stats">
          {homeStats.map((s) => (
            <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
          ))}
        </dl>
        <div class="cluster">
          <a class="btn btn--dark" href="/about-us/company-profile/">Our story <Icon name="arrow-right" /></a>
          <a class="link-arrow" href="/about-us/history-milestones/">History &amp; milestones <Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
    <div class="container">
      <ul role="list" class="creds" data-reveal-stagger="80">
        {credentials.map((c) => <li><Icon name={c.icon} /><span>{c.text}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- ============ MD QUOTE ============ -->
  <section class="section--sm quote-band" aria-labelledby="quote-title">
    <div class="container quote">
      <Image src={mdPortrait} alt="Rakesh Dommati, Managing Director" width={200} height={200} class="quote__img" />
      <figure class="quote__body" data-reveal>
        <Icon name="quote" class="quote__mark" />
        <p class="eyebrow" id="quote-title">{mdMessage.title}</p>
        <blockquote>
          <p>“{mdMessage.closingQuote}”</p>
        </blockquote>
        <figcaption>
          <span><strong>{mdMessage.name}</strong>, {mdMessage.role}</span>
          <a class="link-arrow" href="/about-us/managing-directors-message/">Read the full message <Icon name="arrow-right" /></a>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ FRANCHISE ============ -->
  <section class="section franchise" aria-labelledby="franchise-title">
    <div class="container">
      <div class="franchise__card on-orange" data-reveal>
        <div class="franchise__copy">
          <p class="eyebrow eyebrow--plain franchise__eyebrow">{homeFranchise.eyebrow}</p>
          <h2 class="t-h2" id="franchise-title">{homeFranchise.title}</h2>
          <p class="franchise__lead">{growBusiness.body}</p>
          <ul role="list" class="franchise__points">
            {storePromise.benefits.slice(0, 4).map((b) => (
              <li><Icon name="check" /><span><strong>{b.title}:</strong> {b.body}</span></li>
            ))}
          </ul>
          <div class="cluster">
            <button type="button" class="btn btn--dark" data-open-dialog="dialog-franchise">Become a Partner <Icon name="arrow-right" /></button>
            <a class="btn btn--white" href="/franchise/">Franchise details</a>
          </div>
          <p class="franchise__call"><Icon name="phone" /> Call us now: <a href={`tel:${franchisePhone}`}>{franchisePhone}</a></p>
        </div>
        <div class="franchise__media">
          <Image src={storeInterior} alt="A Retina Paints exclusive showroom" widths={[480, 800]} sizes="(max-width: 960px) 100vw, 40vw" class="franchise__img" />
          <dl class="franchise__stats">
            {growBusiness.stats.map((s) => <div><dd>{s.value}</dd><dt>{s.label}</dt></div>)}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ NEWS ============ -->
  <section class="section section--flush-top news" aria-labelledby="news-title">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div class="stack" style="--stack: var(--s-4)">
          <p class="eyebrow">News &amp; Events</p>
          <h2 class="t-h2" id="news-title">{blogTitle}</h2>
        </div>
        <a class="link-arrow" href="/news-and-events/">All news &amp; events <Icon name="arrow-right" /></a>
      </div>
      <div class="news__grid">
        {posts.map((p, i) => (
          <article class="post" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="post__media">
              <Image src={p.cover} alt={p.coverAlt} widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 34vw" />
            </div>
            <div class="post__body">
              <p class="post__meta"><span class="post__cat">{p.category}</span><time datetime={p.date}>{fmtDate(p.date)}</time></p>
              <h3 class="t-h3"><a href={`/${p.slug}/`}>{p.title}</a></h3>
            </div>
          </article>
        ))}
        <aside class="ann" aria-labelledby="ann-title" data-reveal style="--reveal-delay: 180ms">
          <h3 class="ann__title" id="ann-title">General announcements</h3>
          <ul role="list">
            {announcements.slice(0, 5).map((a) => (
              <li>
                <a href={docUrl(a.href)} target="_blank" rel="noopener">
                  <Icon name="file-text" />
                  <span>{a.label}<span class="sr-only"> (PDF, opens in a new tab)</span></span>
                </a>
              </li>
            ))}
          </ul>
          <a class="link-arrow" href="/news-and-events/#announcements">View all announcements <Icon name="arrow-right" /></a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Franchise prompt (the live homepage shows this as a pop-up) -->
  <Fragment slot="after">
    <aside class="promo" aria-labelledby="promo-title" hidden data-promo>
      <button type="button" class="promo__close" aria-label="Dismiss" data-promo-close><Icon name="close" /></button>
      <p class="eyebrow">Franchise</p>
      <h2 id="promo-title">{franchisePromo.title}</h2>
      {franchisePromo.lines.map((l) => <p>{l}</p>)}
      <div class="promo__actions">
        <a class="btn btn--sm" href="/franchise/">Know More</a>
        <button type="button" class="btn btn--sm btn--secondary" data-open-dialog="dialog-promo-video"><Icon name="play" /> Watch</button>
        <button type="button" class="promo__later" data-promo-close>Maybe Later</button>
      </div>
    </aside>
    <Modal id="dialog-promo-video" title={franchisePromo.title} eyebrow="Franchise" size="lg">
      <VideoEmbed id={franchisePromo.youtubeId} title="Own a Retina Paints Franchise" />
    </Modal>
  </Fragment>
</BaseLayout>

<script>
  // Franchise prompt: shown once per session, after the visitor engages.
  const promo = document.querySelector<HTMLElement>('[data-promo]');
  if (promo) {
    let seen = false;
    try { seen = sessionStorage.getItem('rp-promo') === '1'; } catch {}
    const show = () => {
      if (seen) return;
      seen = true;
      promo.hidden = false;
      try { sessionStorage.setItem('rp-promo', '1'); } catch {}
    };
    if (!seen) {
      // Never pop up over a tool the visitor is using (the colour visualizer); wait until it is off-screen.
      const avoid = Array.from(document.querySelectorAll<HTMLElement>('[data-float-avoid]'));
      const busy = () => avoid.some((el) => {
        const r = el.getBoundingClientRect();
        return r.top < window.innerHeight && r.bottom > 0;
      });
      let due = false;
      const attempt = () => {
        if (!due || busy()) return;
        window.removeEventListener('scroll', onScroll);
        show();
      };
      const onScroll = () => {
        if (window.scrollY > document.documentElement.scrollHeight * 0.35) due = true;
        attempt();
      };
      window.setTimeout(() => { due = true; attempt(); }, 15000);
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    promo.querySelectorAll('[data-promo-close]').forEach((b) => b.addEventListener('click', () => (promo.hidden = true)));
  }
</script>

<style>
  /* ---------- Quick access ---------- */
  .quick { position: relative; z-index: 2; margin-top: calc(-1 * clamp(1rem, 0.5rem + 1.5vw, 2rem)); }
  .quick__list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--white);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .quick__item {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.55rem;
    padding: var(--s-6) var(--s-5) var(--s-6);
    transition: background-color var(--t-base);
  }
  .quick__item + .quick__item { border-left: 1px solid var(--line); }
  .quick__item:hover { background: var(--orange-50); }
  .quick__item::before { content: ''; position: absolute; left: var(--s-5); right: var(--s-5); top: 0; height: 3px; border-radius: 0 0 3px 3px; background: var(--orange-500); transform: scaleX(0); transform-origin: left; transition: transform 400ms var(--ease-out); }
  .quick__item:hover::before { transform: scaleX(1); }
  .quick__icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; margin-bottom: 0.25rem; border-radius: 14px; background: var(--orange-50); box-shadow: inset 0 0 0 1px var(--orange-200); color: var(--orange-700); transition: background-color 260ms var(--ease-out), color 260ms var(--ease-out), transform 300ms var(--ease-out); }
  .quick__icon :global(.icon) { width: 1.35rem; height: 1.35rem; stroke-width: 1.75; }
  .quick__item:hover .quick__icon { background: var(--orange-500); color: var(--white); box-shadow: none; transform: translateY(-2px); }
  .quick__title {
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink-deep);
    text-align: left;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .quick__title::after { content: ''; position: absolute; inset: 0; }
  .quick__title:focus-visible { outline: none; }
  .quick__item:has(.quick__title:focus-visible) { outline: 3px solid var(--ink-deep); outline-offset: -3px; }
  .quick__desc { font-size: var(--fs-label); line-height: 1.5; color: var(--ink-soft); }
  .quick__item :global(.quick__arrow) { position: absolute; right: var(--s-5); top: var(--s-6); width: 1.1rem; height: 1.1rem; color: var(--orange-600); opacity: 0; transform: translateX(-4px); transition: opacity var(--t-base), transform var(--t-base) var(--ease-out); }
  .quick__item:hover :global(.quick__arrow) { opacity: 1; transform: none; }
  @media (max-width: 1180px) {
    .quick__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .quick__item:nth-child(4) { border-left: 0; }
    .quick__item:nth-child(n + 4) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 640px) {
    .quick__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .quick__item { padding: var(--s-5) var(--s-4); }
    .quick__item:nth-child(4) { border-left: 1px solid var(--line); }
    .quick__item:nth-child(odd) { border-left: 0; }
    .quick__item:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .quick__desc { display: none; }
    .quick__item :global(.quick__arrow) { display: none; }
  }

  /* ---------- Exterior band ---------- */
  .exterior {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--white);
    background: #1d1a1f;
  }
  .exterior :global(.exterior__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }
  .exterior::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(20 16 14 / 0.86) 0%, rgb(20 16 14 / 0.62) 42%, rgb(20 16 14 / 0.08) 75%);
  }
  .exterior__inner {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s-8);
    align-items: end;
    padding-block: clamp(4rem, 3rem + 6vw, 8.5rem);
  }
  .exterior__copy { display: grid; gap: var(--s-5); justify-items: start; max-width: 36rem; }
  .exterior__copy h2 { color: var(--white); }
  .exterior__lead { font-size: var(--fs-lead); color: rgb(255 255 255 / 0.84); }
  .exterior__list { display: grid; gap: var(--s-3); margin: 0; padding: 0; list-style: none; }
  .exterior__item {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr) auto;
    gap: var(--s-4);
    align-items: center;
    padding: var(--s-3) var(--s-5) var(--s-3) var(--s-3);
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.1);
    backdrop-filter: blur(12px);
    color: var(--white);
    text-decoration: none;
    transition: background-color var(--t-base), border-color var(--t-base);
  }
  .exterior__item:hover { background: rgb(255 255 255 / 0.2); border-color: rgb(255 255 255 / 0.45); }
  .exterior__item :global(.exterior__pack) { width: 3.75rem; height: auto; }
  .exterior__item strong { display: block; font-family: var(--font-display); font-size: 1.0625rem; }
  .exterior__item span span { font-size: var(--fs-ui); color: var(--orange-200); }
  .exterior__item > :global(.icon) { color: var(--orange-300); }
  @media (max-width: 960px) {
    .exterior__inner { grid-template-columns: minmax(0, 1fr); }
    .exterior::before { background: linear-gradient(180deg, rgb(20 16 14 / 0.55) 0%, rgb(20 16 14 / 0.86) 60%); }
  }

  /* ---------- Section tones ---------- */
  .viz-section { position: relative; background: linear-gradient(180deg, var(--orange-50) 0%, var(--cream) 100%); }
  .viz-section::before { content: ''; position: absolute; left: 50%; top: 0; width: min(var(--container), 100% - 2 * var(--gutter)); height: 3px; transform: translateX(-50%); background: linear-gradient(90deg, var(--orange-500) 0 18%, var(--orange-300) 18% 26%, var(--orange-100) 26% 32%, transparent 32%); border-radius: 0 0 3px 3px; }
  .news { background: linear-gradient(180deg, var(--white) 30%, var(--cream) 100%); }

  /* ---------- Why ---------- */
  .why__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 1rem + 4vw, 6rem); align-items: start; }
  .why__head { position: sticky; top: calc(var(--header-h) + 2rem); display: grid; gap: var(--s-4); }
  .why__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  .why__item { position: relative; display: grid; gap: var(--s-3); align-content: start; padding: var(--s-6) 0 var(--s-7); border-top: 1px solid var(--line-strong); }
  .why__item::before { content: ''; position: absolute; left: 0; top: -1px; width: 3rem; height: 2px; background: var(--orange-500); transition: width 600ms var(--ease-out); }
  .why__item:hover::before { width: 100%; }
  .why__item .why__icon { transition: background-color 260ms var(--ease-out), color 260ms var(--ease-out); }
  .why__item:hover .why__icon { background: var(--orange-500); color: var(--ink-deep); }
