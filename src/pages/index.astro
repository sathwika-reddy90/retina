---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import ProductCard from '@/components/ProductCard.astro';
import Visualizer from '@/components/Visualizer.astro';
import VideoEmbed from '@/components/VideoEmbed.astro';
import Modal from '@/components/Modal.astro';

import livingRoom from '@/assets/rooms/living-room.png';
import livingRoomShade from '@/assets/rooms/light/living-room-shade.png';
import livingRoomLight from '@/assets/rooms/light/living-room-light.png';
import exteriorHome from '@/assets/imagery/exterior-home.jpg';
import storeInterior from '@/assets/imagery/store-interior.jpg';
import officeBuilding from '@/assets/imagery/office-building.jpg';
import bseListing from '@/assets/news/bse/Retinas-Shares-got-listed-in-BSE-SME-Platform-2.jpg';
import mdPortrait from '@/assets/team/md-portrait.png';
import royalVogue from '@/assets/products/royal-vogue.png';

import { company, homeStats, experience, homeVision, homeMission, franchisePhone } from '@/data/site';
import { products, productBySlug, homeFeatured, type Product } from '@/data/products';
import { whyChooseUs, mdMessage } from '@/data/about';
import { storePromise, growBusiness, franchisePromo, homeFranchise } from '@/data/franchise';
import { posts, announcements, blogTitle } from '@/data/news';
import { findShade, shadeCount } from '@/data/colours';
import { docUrl } from '@/data/site';

const inkOn = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  return 0.299 * r + 0.587 * g + 0.114 * b > 150 ? 'dark' : 'light';
};
const shadeTotal = shadeCount.toLocaleString('en-IN');
const heroShades = ['QC0263', 'QC1213', 'QC0164', 'QC1013', 'QC0604', 'QC0465', 'QC1105'].map((c) => findShade(c)!);
const heroRoom = await getImage({ src: livingRoom, width: 1280, format: 'webp', quality: 80 });
const heroShade = await getImage({ src: livingRoomShade, width: 1280, format: 'webp', quality: 72 });
const heroLight = await getImage({ src: livingRoomLight, width: 1280, format: 'webp', quality: 72 });
const heroRoomSm = await getImage({ src: livingRoom, width: 760, format: 'webp', quality: 78 });

const pick = (slugs: string[]) => slugs.map((s) => productBySlug(s)).filter((p): p is Product => Boolean(p));
const tabs: { id: string; label: string; items: Product[] }[] = [
  { id: 'featured', label: 'Featured', items: pick(homeFeatured) },
  { id: 'exterior', label: 'Exterior Emulsions', items: products.filter((p) => p.category === 'exterior-emulsions') },
  { id: 'interior', label: 'Interior Emulsions', items: products.filter((p) => p.category === 'interior-emulsions') },
  { id: 'primers', label: 'Primers', items: products.filter((p) => p.category.endsWith('primers')) },
  { id: 'distempers', label: 'Distempers & Enamels', items: products.filter((p) => p.category === 'distempers' || p.category === 'enamels') },
  { id: 'putty', label: 'Putty & Texture', items: products.filter((p) => p.category === 'putty') },
];
const exteriorTrio = pick(['weather-expert', 'expo-ultimax', 'expo-advanced']);

const quickLinks = [
  { icon: 'brush', title: 'Explore Paints', text: 'Emulsions, primers, distempers, putty and textures for every surface.', href: '/products/' },
  { icon: 'palette', title: 'Discover Colours', text: `Browse ${(Math.floor(shadeCount / 100) * 100).toLocaleString('en-IN')}+ Retina shades and preview them in a room.`, href: '/colors/' },
  { icon: 'map-pin', title: 'Find a Store', text: 'Locate your nearest Retina store for top-quality paints and expert advice!', href: '/find-a-store-near-you/' },
  { icon: 'sparkles', title: 'Get Expert Advice', text: 'Need help choosing the right paint? Our experts are here to guide you!', dialog: 'dialog-advice' },
];

const credentials = [
  { icon: 'certificate', text: 'ISO 9001:2015 certified company' },
  { icon: 'trending-up', text: 'Equity shares listed on the BSE SME Platform since 3 May 2023' },
  { icon: 'factory', text: 'Operations at its own land & building, Rayaraopet near Ghatkesar, Hyderabad' },
  { icon: 'badge-check', text: 'Logo registered under the Trademarks Act, 1999' },
];
const fmtDate = (iso: string) => new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Home" description={company.intro}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroRoom.src} imagesrcset={`${heroRoomSm.src} 760w, ${heroRoom.src} 1280w`} imagesizes="(max-width: 960px) 100vw, 52vw" fetchpriority="high" />
  </Fragment>

  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__bg" aria-hidden="true">
      <span class="hero__glow"></span>
      <span class="hero__ring hero__ring--lg"></span>
      <span class="hero__ring hero__ring--sm"></span>
    </div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow hero__in" style="--i:0">{company.tagline}</p>
        <h1 class="t-display hero__title hero__in" style="--i:1" id="hero-title">
          Transform your space with
          <span class="stroke">
            <span class="stroke__text">superior paints</span>
            <svg class="stroke__paint" viewBox="0 0 500 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path class="stroke__body" d="M6 34C18 18 70 14 140 15c80 1 160-5 240-3 50 1 92 2 110 10 9 5 7 18-4 23-16 7-66 5-126 6-80 2-160-1-230 2-50 2-100 3-118-3-9-3-11-10-6-16Z" />
              <path class="stroke__streak" d="M28 25c96-5 236-8 420-5M34 44c126 3 276 0 436-3" />
              <path class="stroke__shine" d="M60 31c120-3 250-5 380-3" />
            </svg>
          </span>
        </h1>
        <p class="t-lead hero__lead hero__in" style="--i:2">{company.intro.split('. With')[0]}.</p>
        <div class="hero__ctas">
          <a class="btn btn--lg hero__in" style="--i:3" href="/products/">Browse Products <Icon name="arrow-right" /></a>
          <a class="btn btn--lg btn--secondary hero__in" style="--i:4" href="/colors/"><Icon name="palette" /> Explore Colours</a>
        </div>
        <ul role="list" class="hero__trust hero__in" style="--i:5">
          <li><span class="hero__trust-icon"><Icon name="certificate" /></span><span>ISO 9001:2015 <br />certified</span></li>
          <li><span class="hero__trust-icon"><Icon name="trending-up" /></span><span>Listed on <br />BSE SME</span></li>
          <li><span class="hero__trust-icon"><Icon name="shield" /></span><span>Up to 8 years <br />warranty</span></li>
        </ul>
      </div>

      <div class="hero__visual" data-hero-room style={`--wall:${heroShades[0].hex}`}>
        <div class="hero__stage">
          <div class="hero__frame">
            <div class="hero__scene">
              <div class="hero__paint" aria-hidden="true"></div>
              <img src={heroShade.src} alt="" class="hero__shade" width={heroShade.attributes.width} height={heroShade.attributes.height} decoding="async" aria-hidden="true" />
              <img src={heroLight.src} alt="" class="hero__light" width={heroLight.attributes.width} height={heroLight.attributes.height} decoding="async" aria-hidden="true" />
              <img
                class="hero__photo"
                src={heroRoom.src}
                srcset={`${heroRoomSm.src} 760w, ${heroRoom.src} 1280w`}
                sizes="(max-width: 960px) 100vw, 52vw"
                width={heroRoom.attributes.width}
                height={heroRoom.attributes.height}
                alt="A bright living room with a white sofa, curtains and a plant, its walls painted in a Retina shade"
                fetchpriority="high"
                decoding="async"
              />
            </div>
            <div class="hero__card">
              <span class="hero__card-chip"></span>
              <span class="hero__card-text">
                <span class="hero__card-label">On the wall</span>
                <strong data-hero-code>{heroShades[0].code}</strong>
              </span>
              <a href={`/colors/#${heroShades[0].code}`} class="hero__card-link" data-hero-link aria-label={`Open ${heroShades[0].code} in the colour visualizer`}><Icon name="arrow-up-right" /></a>
            </div>
          </div>

          <div class="palette" role="radiogroup" aria-label="Try a Retina shade on the wall" data-palette>
            <p class="palette__title" aria-hidden="true">Shades</p>
            {heroShades.map((s, i) => (
              <button
                type="button"
                role="radio"
                class="hero__chip"
                style={`--c:${s.hex};--i:${i}`}
                data-code={s.code}
                data-hex={s.hex}
                data-ink={inkOn(s.hex)}
                aria-checked={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                aria-label={`Paint the wall ${s.code}`}
              >
                <Icon name="check" class="hero__chip-check" />
                <span class="palette__tip" aria-hidden="true">{s.code}</span>
              </button>
            ))}
            <a class="palette__more" href="/colors/" style={`--i:${heroShades.length}`} aria-label={`Explore all ${shadeTotal} Retina shades in the colour visualizer`}>
              <Icon name="plus" />
              <span class="palette__tip" aria-hidden="true">All {shadeTotal} shades</span>
            </a>
          </div>

          <Image src={royalVogue} alt="" width={240} height={250} class="hero__pack" loading="eager" />
        </div>
        <p class="hero__hint"><Icon name="hand" /> Tap a shade to repaint the room · <a href="/colors/">Open the colour visualizer</a></p>
      </div>
    </div>
  </section>

  <!-- ============ QUICK DISCOVERY ============ -->
  <section class="quick" aria-label="Quick links">
    <div class="container">
      <ul role="list" class="quick__list" data-reveal>
        {quickLinks.map((q) => (
          <li class="quick__item">
            <span class="quick__icon"><Icon name={q.icon} /></span>
            <span class="quick__text">
              {q.href ? (
                <a href={q.href} class="quick__title">{q.title}</a>
              ) : (
                <button type="button" class="quick__title" data-open-dialog={q.dialog}>{q.title}</button>
              )}
              <span class="quick__desc">{q.text}</span>
            </span>
            <Icon name="arrow-right" class="quick__arrow" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ PRODUCTS ============ -->
  <section class="section showcase" aria-labelledby="products-title">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div class="stack" style="--stack: var(--s-4)">
          <p class="eyebrow">Our Products</p>
          <h2 class="t-h2" id="products-title">Premium Paints for Every Surface</h2>
          <p class="t-lead">Explore our wide range of high-quality paints, primers, enamels, and textures.</p>
        </div>
        <a class="link-arrow" href="/products/">View all products <Icon name="arrow-right" /></a>
      </div>

      <div class="tabs" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="Product categories">
          {tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={`panel-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {t.label}
            </button>
          ))}
        </div>
        {tabs.map((t, i) => (
          <div class="tabs__panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0} tabindex="0">
            <div class="rail" data-rail>
              <ul role="list" class="rail__track">
                {t.items.map((p) => <li class="rail__item"><ProductCard product={p} /></li>)}
              </ul>
              <div class="rail__nav">
                <button type="button" class="rail__btn" data-rail-prev aria-label="Previous products"><Icon name="arrow-left" /></button>
                <button type="button" class="rail__btn" data-rail-next aria-label="Next products"><Icon name="arrow-right" /></button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EXTERIOR PROTECTION ============ -->
  <section class="exterior on-dark" aria-labelledby="exterior-title">
    <Image src={exteriorHome} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="exterior__bg" loading="lazy" />
    <div class="container exterior__inner">
      <div class="exterior__copy" data-reveal>
        <p class="eyebrow eyebrow--light">Exterior Emulsions</p>
        <h2 class="t-h2" id="exterior-title">Shield Your Home with Long-Lasting Protection!</h2>
        <p class="exterior__lead">Beauty That Lasts, Protection That Endures. Our exterior emulsions are designed to withstand extreme weather conditions, protecting your walls from rain, UV rays, and dust.</p>
        <a class="btn" href="/products/#exterior-emulsions">Explore Exterior Paints <Icon name="arrow-right" /></a>
      </div>
      <ul role="list" class="exterior__list" data-reveal style="--reveal-delay: 120ms">
        {exteriorTrio.map((p) => (
          <li>
            <a href={p.href!} class="exterior__item">
              <Image src={p.image} alt="" width={120} height={125} class="exterior__pack" />
              <span>
                <strong>{p.name}</strong>
                <span>{p.warranty} Years Warranty</span>
              </span>
              <Icon name="arrow-right" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ COLOUR VISUALIZER ============ -->
  <section class="section viz-section" aria-labelledby="viz-title" id="visualizer">
    <div class="container">
      <div style="--viz-bg: var(--orange-50)">
        <Visualizer variant="compact" id="home-viz" initialRoom="bed-room" headingLevel="h3">
          <div class="stack viz-head" style="--stack: var(--s-3)" slot="intro">
            <p class="eyebrow">Color Visualizer</p>
            <h2 class="t-h2" id="viz-title">Experience Your Own Color Combination</h2>
            <p class="t-lead">Choose a room, explore beautiful Retina shades, and see your walls transform instantly. <a class="link-arrow" href="/colors/">Open the full visualizer <Icon name="arrow-right" /></a></p>
          </div>
        </Visualizer>
      </div>
    </div>
  </section>

  <!-- ============ WHY CHOOSE US ============ -->
  <section class="section why" aria-labelledby="why-title">
    <div class="container why__grid">
      <div class="why__head" data-reveal>
        <p class="eyebrow">{whyChooseUs.eyebrow}</p>
        <h2 class="t-h2" id="why-title">{whyChooseUs.title}</h2>
        <p class="t-lead">{whyChooseUs.intro}</p>
      </div>
      <ol role="list" class="why__list" data-reveal-stagger="90">
        {whyChooseUs.items.map((item, i) => (
          <li class="why__item">
            <span class="why__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="why__icon"><Icon name={item.icon} /></span>
            <h3 class="t-h4">{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ BRAND STORY ============ -->
  <section class="section section--flush-top story" aria-labelledby="story-title">
    <div class="container story__grid">
      <div class="story__media" data-reveal>
        <Image src={bseListing} alt="Retina Paints management at the BSE on the day the company’s shares were listed" widths={[480, 800, 1024]} sizes="(max-width: 960px) 100vw, 46vw" class="story__img story__img--main" />
        <Image src={officeBuilding} alt="Retina Paints Limited building with company signage" widths={[320, 520]} sizes="(max-width: 960px) 50vw, 20vw" class="story__img story__img--small" />
        <div class="story__stat">
          <strong>{experience.value}</strong>
          <span>{experience.label}</span>
        </div>
      </div>
      <div class="story__copy" data-reveal style="--reveal-delay: 100ms">
        <p class="eyebrow">About Retina Paints</p>
        <h2 class="t-h2" id="story-title">“{company.tagline}”</h2>
        <p class="t-lead">{company.intro}</p>
        <dl class="story__vm">
          <div><dt>Our Vision</dt><dd>{homeVision}</dd></div>
          <div><dt>Our Mission</dt><dd>{homeMission}</dd></div>
        </dl>
        <dl class="story__stats">
          {homeStats.map((s) => (
            <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
          ))}
        </dl>
        <div class="cluster">
          <a class="btn btn--dark" href="/about-us/company-profile/">Our story <Icon name="arrow-right" /></a>
          <a class="link-arrow" href="/about-us/history-milestones/">History &amp; milestones <Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
    <div class="container">
      <ul role="list" class="creds" data-reveal-stagger="80">
        {credentials.map((c) => <li><Icon name={c.icon} /><span>{c.text}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- ============ MD QUOTE ============ -->
  <section class="section--sm quote-band" aria-labelledby="quote-title">
    <div class="container quote">
      <Image src={mdPortrait} alt="Rakesh Dommati, Managing Director" width={200} height={200} class="quote__img" />
      <figure class="quote__body" data-reveal>
        <Icon name="quote" class="quote__mark" />
        <p class="eyebrow" id="quote-title">{mdMessage.title}</p>
        <blockquote>
          <p>“{mdMessage.closingQuote}”</p>
        </blockquote>
        <figcaption>
          <span><strong>{mdMessage.name}</strong>, {mdMessage.role}</span>
          <a class="link-arrow" href="/about-us/managing-directors-message/">Read the full message <Icon name="arrow-right" /></a>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ FRANCHISE ============ -->
  <section class="section franchise" aria-labelledby="franchise-title">
    <div class="container">
      <div class="franchise__card on-orange" data-reveal>
        <div class="franchise__copy">
          <p class="eyebrow eyebrow--plain franchise__eyebrow">{homeFranchise.eyebrow}</p>
          <h2 class="t-h2" id="franchise-title">{homeFranchise.title}</h2>
          <p class="franchise__lead">{growBusiness.body}</p>
          <ul role="list" class="franchise__points">
            {storePromise.benefits.slice(0, 4).map((b) => (
              <li><Icon name="check" /><span><strong>{b.title}:</strong> {b.body}</span></li>
            ))}
          </ul>
          <div class="cluster">
            <button type="button" class="btn btn--dark" data-open-dialog="dialog-franchise">Become a Partner <Icon name="arrow-right" /></button>
            <a class="btn btn--white" href="/franchise/">Franchise details</a>
          </div>
          <p class="franchise__call"><Icon name="phone" /> Call us now: <a href={`tel:${franchisePhone}`}>{franchisePhone}</a></p>
        </div>
        <div class="franchise__media">
          <Image src={storeInterior} alt="A Retina Paints exclusive showroom" widths={[480, 800]} sizes="(max-width: 960px) 100vw, 40vw" class="franchise__img" />
          <dl class="franchise__stats">
            {growBusiness.stats.map((s) => <div><dd>{s.value}</dd><dt>{s.label}</dt></div>)}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ NEWS ============ -->
  <section class="section section--flush-top news" aria-labelledby="news-title">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div class="stack" style="--stack: var(--s-4)">
          <p class="eyebrow">News &amp; Events</p>
          <h2 class="t-h2" id="news-title">{blogTitle}</h2>
        </div>
        <a class="link-arrow" href="/news-and-events/">All news &amp; events <Icon name="arrow-right" /></a>
      </div>
      <div class="news__grid">
        {posts.map((p, i) => (
          <article class="post" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="post__media">
              <Image src={p.cover} alt={p.coverAlt} widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 34vw" />
            </div>
            <div class="post__body">
              <p class="post__meta"><span class="post__cat">{p.category}</span><time datetime={p.date}>{fmtDate(p.date)}</time></p>
              <h3 class="t-h3"><a href={`/${p.slug}/`}>{p.title}</a></h3>
            </div>
          </article>
        ))}
        <aside class="ann" aria-labelledby="ann-title" data-reveal style="--reveal-delay: 180ms">
          <h3 class="ann__title" id="ann-title">General announcements</h3>
          <ul role="list">
            {announcements.slice(0, 5).map((a) => (
              <li>
                <a href={docUrl(a.href)} target="_blank" rel="noopener">
                  <Icon name="file-text" />
                  <span>{a.label}<span class="sr-only"> (PDF, opens in a new tab)</span></span>
                </a>
              </li>
            ))}
          </ul>
          <a class="link-arrow" href="/news-and-events/#announcements">View all announcements <Icon name="arrow-right" /></a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Franchise prompt (the live homepage shows this as a pop-up) -->
  <Fragment slot="after">
    <aside class="promo" aria-labelledby="promo-title" hidden data-promo>
      <button type="button" class="promo__close" aria-label="Dismiss" data-promo-close><Icon name="close" /></button>
      <p class="eyebrow">Franchise</p>
      <h2 id="promo-title">{franchisePromo.title}</h2>
      {franchisePromo.lines.map((l) => <p>{l}</p>)}
      <div class="promo__actions">
        <a class="btn btn--sm" href="/franchise/">Know More</a>
        <button type="button" class="btn btn--sm btn--secondary" data-open-dialog="dialog-promo-video"><Icon name="play" /> Watch</button>
        <button type="button" class="promo__later" data-promo-close>Maybe Later</button>
      </div>
    </aside>
    <Modal id="dialog-promo-video" title={franchisePromo.title} eyebrow="Franchise" size="lg">
      <VideoEmbed id={franchisePromo.youtubeId} title="Own a Retina Paints Franchise" />
    </Modal>
  </Fragment>
</BaseLayout>

<script>
  // Hero: the docked palette repaints the room (radio group with arrow-key support).
  const hero = document.querySelector<HTMLElement>('[data-hero-room]');
  if (hero) {
    const code = hero.querySelector<HTMLElement>('[data-hero-code]')!;
    const link = hero.querySelector<HTMLAnchorElement>('[data-hero-link]')!;
    const chips = Array.from(hero.querySelectorAll<HTMLButtonElement>('.hero__chip'));
    const pick = (chip: HTMLButtonElement, focus = false) => {
      hero.style.setProperty('--wall', chip.dataset.hex!);
      chips.forEach((c) => {
        const on = c === chip;
        c.setAttribute('aria-checked', String(on));
        c.tabIndex = on ? 0 : -1;
      });
      if (code.textContent !== chip.dataset.code) {
        code.textContent = chip.dataset.code!;
        code.removeAttribute('data-swap');
        void code.offsetWidth; // restart the label animation
        code.setAttribute('data-swap', '');
      }
      link.href = `/colors/#${chip.dataset.code}`;
      link.setAttribute('aria-label', `Open ${chip.dataset.code} in the colour visualizer`);
      if (focus) chip.focus();
    };
    chips.forEach((chip, i) => {
      chip.addEventListener('click', () => pick(chip));
      chip.addEventListener('keydown', (e) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
        if (step === undefined) return;
        e.preventDefault();
        pick(chips[(i + step + chips.length) % chips.length], true);
      });
    });
  }

  // Tabs (WAI-ARIA tabs pattern with automatic activation).
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const activate = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => activate(t));
      t.addEventListener('keydown', (e) => {
        const map: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
        if (!(e.key in map)) return;
        e.preventDefault();
        activate(tabs[(map[e.key] + tabs.length) % tabs.length], true);
      });
    });
  });

  // Horizontal product rails.
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
    const track = rail.querySelector<HTMLElement>('.rail__track')!;
    const prev = rail.querySelector<HTMLButtonElement>('[data-rail-prev]')!;
    const next = rail.querySelector<HTMLButtonElement>('[data-rail-next]')!;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
      rail.toggleAttribute('data-static', max <= 0);
    };
    const step = () => (track.querySelector<HTMLElement>('.rail__item')?.offsetWidth ?? 300) + 24;
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
  });

  // Franchise prompt: shown once per session, after the visitor engages.
  const promo = document.querySelector<HTMLElement>('[data-promo]');
  if (promo) {
    let seen = false;
    try { seen = sessionStorage.getItem('rp-promo') === '1'; } catch {}
    const show = () => {
      if (seen) return;
      seen = true;
      promo.hidden = false;
      try { sessionStorage.setItem('rp-promo', '1'); } catch {}
    };
    if (!seen) {
      // Never pop up over a tool the visitor is using (the colour visualizer); wait until it is off-screen.
      const avoid = Array.from(document.querySelectorAll<HTMLElement>('[data-float-avoid]'));
      const busy = () => avoid.some((el) => {
        const r = el.getBoundingClientRect();
        return r.top < window.innerHeight && r.bottom > 0;
      });
      let due = false;
      const attempt = () => {
        if (!due || busy()) return;
        window.removeEventListener('scroll', onScroll);
        show();
      };
      const onScroll = () => {
        if (window.scrollY > document.documentElement.scrollHeight * 0.35) due = true;
        attempt();
      };
      window.setTimeout(() => { due = true; attempt(); }, 15000);
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    promo.querySelectorAll('[data-promo-close]').forEach((b) => b.addEventListener('click', () => (promo.hidden = true)));
  }
</script>

