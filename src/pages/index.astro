---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Visualizer from '@/components/Visualizer.astro';
import VideoEmbed from '@/components/VideoEmbed.astro';
import Modal from '@/components/Modal.astro';
import CategoryGrid from '@/components/home/CategoryGrid.astro';
import ColourCarousel from '@/components/home/ColourCarousel.astro';
import FeaturedProducts from '@/components/home/FeaturedProducts.astro';
import BeyondColours from '@/components/home/BeyondColours.astro';
import ColourTools from '@/components/home/ColourTools.astro';
import DesignerCollections from '@/components/home/DesignerCollections.astro';
import OneStop from '@/components/home/OneStop.astro';
import PaintCalculator from '@/components/home/PaintCalculator.astro';
import Inspiration from '@/components/home/Inspiration.astro';

import bedroom from '@/assets/rooms/bedroom.png';
import bedroomShade from '@/assets/rooms/light/bedroom-shade.png';
import bedroomLight from '@/assets/rooms/light/bedroom-light.png';
import exteriorHome from '@/assets/imagery/exterior-home.jpg';
import storeInterior from '@/assets/imagery/store-interior.jpg';
import officeBuilding from '@/assets/imagery/office-building.jpg';
import bseListing from '@/assets/news/bse/Retinas-Shares-got-listed-in-BSE-SME-Platform-2.jpg';
import mdPortrait from '@/assets/team/md-portrait.png';

import { company, homeStats, experience, homeVision, homeMission, franchisePhone } from '@/data/site';
import { productBySlug, type Product } from '@/data/products';
import { whyChooseUs, mdMessage } from '@/data/about';
import { storePromise, growBusiness, franchisePromo, homeFranchise } from '@/data/franchise';
import { posts, announcements, blogTitle } from '@/data/news';
import { findShade, shadeCount } from '@/data/colours';
import { docUrl } from '@/data/site';

const inkOn = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  return 0.299 * r + 0.587 * g + 0.114 * b > 150 ? 'dark' : 'light';
};
// A curated campaign palette of real Retina codes; the first is the brand orange every visualizer opens on.
const heroShades = ['QC0241', 'QC1211', 'QC0192', 'QC1013', 'QC0912', 'QC0671', 'QC1175'].map((c) => findShade(c)!);
// The bedroom is the hero photograph: its walls are cut out so the paint layer shows through, with lighting maps on top.
const [heroRoom, heroShade, heroLight] = await Promise.all(
  [bedroom, bedroomShade, bedroomLight].map(async (src, i) => {
    const widths = [800, Math.min(1600, src.width)];
    const set = await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp', quality: i === 0 ? 80 : 72 })));
    return { src: set[1].src, srcset: set.map((img, j) => `${img.src} ${widths[j]}w`).join(', ') };
  }),
);
const heroSizes = '(max-width: 960px) 100vw, 56vw';

const pick = (slugs: string[]) => slugs.map((s) => productBySlug(s)).filter((p): p is Product => Boolean(p));
const exteriorTrio = pick(['weather-expert', 'expo-ultimax', 'expo-advanced']);

// Quick access: each card opens an existing page, section, form or tool on this site.
const quickLinks = [
  { icon: 'brush', title: 'Painting Services', text: 'Need help choosing the right paint? Our experts are here to guide you!', dialog: 'dialog-advice' },
  { icon: 'sliders', title: 'Paint Cost Calculator', text: 'Get an indicative budget for your painting project.', href: '#calculator' },
  { icon: 'droplet', title: 'Waterproofing Solutions', text: 'Waterproof and damp-proof primers for exterior walls.', href: '/products/#waterproof-primers' },
  { icon: 'home', title: 'Interior Painting', text: 'Interior emulsions in matt and high-sheen finishes.', href: '/products/#interior-emulsions' },
  { icon: 'palette', title: 'Explore Colours', text: `Browse ${(Math.floor(shadeCount / 100) * 100).toLocaleString('en-IN')}+ Retina shades and preview them in a room.`, href: '/colors/' },
  { icon: 'map-pin', title: 'Find a Dealer', text: 'Locate your nearest Retina store for top-quality paints and expert advice!', href: '/find-a-store-near-you/' },
];

const credentials = [
  { icon: 'certificate', text: 'ISO 9001:2015 certified company' },
  { icon: 'trending-up', text: 'Equity shares listed on the BSE SME Platform since 3 May 2023' },
  { icon: 'factory', text: 'Operations at its own land & building, Rayaraopet near Ghatkesar, Hyderabad' },
  { icon: 'badge-check', text: 'Logo registered under the Trademarks Act, 1999' },
];
const fmtDate = (iso: string) => new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Home" description={company.intro}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroRoom.src} imagesrcset={heroRoom.srcset} imagesizes={heroSizes} fetchpriority="high" />
  </Fragment>

  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title" data-hero-room style={`--wall:${heroShades[0].hex}`}>
    <div class="hero__panel">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--light hero__in" style="--i:0">Bringing colours to life with innovation &amp; quality</p>
        <h1 class="hero__title hero__in" style="--i:1" id="hero-title">
          <span class="hero__line">Transform</span>
          <span class="hero__line">Your World</span>
          <span class="hero__line">with <span class="hero__accent">Colour</span></span>
        </h1>
        <p class="hero__lead hero__in" style="--i:2">Premium paints that bring lasting beauty, dependable protection and thoughtful design to every wall, inside and out.</p>
        <div class="hero__ctas hero__in" style="--i:3">
          <a class="btn btn--lg" href="/products/">Explore Products <Icon name="arrow-right" /></a>
          <a class="btn btn--lg btn--ghost-light" href="/colors/"><Icon name="palette" /> Explore Colours</a>
        </div>
      </div>
      <ul role="list" class="hero__trust hero__in" style="--i:4">
        <li><span class="hero__trust-icon"><Icon name="certificate" /></span><span>ISO 9001:2015 <br />certified</span></li>
        <li><span class="hero__trust-icon"><Icon name="trending-up" /></span><span>Listed on <br />BSE SME</span></li>
        <li><span class="hero__trust-icon"><Icon name="shield" /></span><span>Up to 8 years <br />warranty</span></li>
      </ul>
    </div>

    <div class="hero__media">
      <div class="hero__scene">
        <div class="hero__paint" aria-hidden="true"></div>
        <img src={heroShade.src} srcset={heroShade.srcset} sizes={heroSizes} alt="" class="hero__shade" width="1280" height="854" decoding="async" aria-hidden="true" />
        <img src={heroLight.src} srcset={heroLight.srcset} sizes={heroSizes} alt="" class="hero__light" width="1280" height="854" decoding="async" aria-hidden="true" />
        <img
          class="hero__photo"
          src={heroRoom.src}
          srcset={heroRoom.srcset}
          sizes={heroSizes}
          width={bedroom.width}
          height={bedroom.height}
          alt="A softly lit bedroom with a velvet bed and pendant lights, its feature wall painted in a Retina shade"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="shadebar hero__in" style="--i:3" data-float-avoid>
        <a href={`/colors/#${heroShades[0].code}`} class="shadebar__code" data-hero-link aria-label={`Open ${heroShades[0].code} in the colour visualizer`}>
          <span class="shadebar__dot" aria-hidden="true"></span>
          <span class="shadebar__text"><span class="shadebar__label">On the wall</span><strong data-hero-code>{heroShades[0].code}</strong></span>
        </a>
        <div class="palette" role="radiogroup" aria-label="Try a Retina shade on the wall" data-palette>
          {heroShades.map((s, i) => (
            <button
              type="button"
              role="radio"
              class="hero__chip"
              style={`--c:${s.hex};--i:${i}`}
              data-code={s.code}
              data-hex={s.hex}
              data-ink={inkOn(s.hex)}
              aria-checked={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              aria-label={`Paint the wall ${s.code}`}
            >
              <Icon name="check" class="hero__chip-check" />
              <span class="palette__tip" aria-hidden="true">{s.code}</span>
            </button>
          ))}
          <a class="palette__more" href="/colors/" aria-label={`Explore all ${shadeCount.toLocaleString('en-IN')} Retina shades in the colour visualizer`}>
            <Icon name="plus" />
            <span class="palette__tip" aria-hidden="true">More shades</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ QUICK ACCESS ============ -->
  <section class="quick" aria-label="Quick access">
    <div class="container">
      <ul role="list" class="quick__list" data-reveal>
        {quickLinks.map((q) => (
          <li class="quick__item">
            <span class="quick__icon"><Icon name={q.icon} /></span>
            {q.href ? (
              <a href={q.href} class="quick__title">{q.title}</a>
            ) : (
              <button type="button" class="quick__title" data-open-dialog={q.dialog}>{q.title}</button>
            )}
            <span class="quick__desc">{q.text}</span>
            <Icon name="arrow-right" class="quick__arrow" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ColourCarousel />
  <FeaturedProducts />
  <CategoryGrid />

  <!-- ============ EXTERIOR PROTECTION ============ -->
  <section class="exterior on-dark" aria-labelledby="exterior-title">
    <Image src={exteriorHome} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="exterior__bg" loading="lazy" />
    <div class="container exterior__inner">
      <div class="exterior__copy" data-reveal>
        <p class="eyebrow eyebrow--light">Exterior Emulsions</p>
        <h2 class="t-h2" id="exterior-title">Shield Your Home with Long-Lasting Protection!</h2>
        <p class="exterior__lead">Beauty That Lasts, Protection That Endures. Our exterior emulsions are designed to withstand extreme weather conditions, protecting your walls from rain, UV rays, and dust.</p>
        <a class="btn" href="/products/#exterior-emulsions">Explore Exterior Paints <Icon name="arrow-right" /></a>
      </div>
      <ul role="list" class="exterior__list" data-reveal style="--reveal-delay: 120ms">
        {exteriorTrio.map((p) => (
          <li>
            <a href={p.href!} class="exterior__item">
              <Image src={p.image} alt="" width={120} height={125} class="exterior__pack" />
              <span>
                <strong>{p.name}</strong>
                <span>{p.warranty} Years Warranty</span>
              </span>
              <Icon name="arrow-right" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ COLOUR VISUALIZER ============ -->
  <section class="section viz-section" aria-labelledby="viz-title" id="visualizer">
    <div class="container">
      <div style="--viz-bg: var(--orange-50)">
        <Visualizer variant="compact" id="home-viz" initialRoom="kids-room" headingLevel="h3">
          <div class="stack viz-head" style="--stack: var(--s-3)" slot="intro">
            <p class="eyebrow">Colour Visualizer</p>
            <h2 class="t-h2" id="viz-title">See Your Walls in a New Light</h2>
            <p class="t-lead">Choose a room, pick a Retina shade and watch only the walls change, with furniture and light left as they are. <a class="link-arrow" href="/colors/">Open the full visualizer <Icon name="arrow-right" /></a></p>
          </div>
        </Visualizer>
      </div>
    </div>
  </section>

  <BeyondColours />
  <ColourTools />
  <DesignerCollections />
  <OneStop />
  <PaintCalculator />
  <Inspiration />

  <!-- ============ WHY CHOOSE US ============ -->
  <section class="section why" aria-labelledby="why-title">
    <div class="container why__grid">
      <div class="why__head" data-reveal>
        <p class="eyebrow">{whyChooseUs.eyebrow}</p>
        <h2 class="t-h2" id="why-title">{whyChooseUs.title}</h2>
        <p class="t-lead">{whyChooseUs.intro}</p>
      </div>
      <ol role="list" class="why__list" data-reveal-stagger="90">
        {whyChooseUs.items.map((item, i) => (
          <li class="why__item">
            <span class="why__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="why__icon"><Icon name={item.icon} /></span>
            <h3 class="t-h4">{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ BRAND STORY ============ -->
  <section class="section section--flush-top story" aria-labelledby="story-title">
    <div class="container story__grid">
      <div class="story__media" data-reveal>
        <Image src={bseListing} alt="Retina Paints management at the BSE on the day the company’s shares were listed" widths={[480, 800, 1024]} sizes="(max-width: 960px) 100vw, 46vw" class="story__img story__img--main" />
        <Image src={officeBuilding} alt="Retina Paints Limited building with company signage" widths={[320, 520]} sizes="(max-width: 960px) 50vw, 20vw" class="story__img story__img--small" />
        <div class="story__stat">
          <strong>{experience.value}</strong>
          <span>{experience.label}</span>
        </div>
      </div>
      <div class="story__copy" data-reveal style="--reveal-delay: 100ms">
        <p class="eyebrow">About Retina Paints</p>
        <h2 class="t-h2" id="story-title">“{company.tagline}”</h2>
        <p class="t-lead">{company.intro}</p>
        <dl class="story__vm">
          <div><dt>Our Vision</dt><dd>{homeVision}</dd></div>
          <div><dt>Our Mission</dt><dd>{homeMission}</dd></div>
        </dl>
        <dl class="story__stats">
          {homeStats.map((s) => (
            <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
          ))}
        </dl>
        <div class="cluster">
          <a class="btn btn--dark" href="/about-us/company-profile/">Our story <Icon name="arrow-right" /></a>
          <a class="link-arrow" href="/about-us/history-milestones/">History &amp; milestones <Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
    <div class="container">
      <ul role="list" class="creds" data-reveal-stagger="80">
        {credentials.map((c) => <li><Icon name={c.icon} /><span>{c.text}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- ============ MD QUOTE ============ -->
  <section class="section--sm quote-band" aria-labelledby="quote-title">
    <div class="container quote">
      <Image src={mdPortrait} alt="Rakesh Dommati, Managing Director" width={200} height={200} class="quote__img" />
      <figure class="quote__body" data-reveal>
        <Icon name="quote" class="quote__mark" />
        <p class="eyebrow" id="quote-title">{mdMessage.title}</p>
        <blockquote>
          <p>“{mdMessage.closingQuote}”</p>
        </blockquote>
        <figcaption>
          <span><strong>{mdMessage.name}</strong>, {mdMessage.role}</span>
          <a class="link-arrow" href="/about-us/managing-directors-message/">Read the full message <Icon name="arrow-right" /></a>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ FRANCHISE ============ -->
  <section class="section franchise" aria-labelledby="franchise-title">
    <div class="container">
      <div class="franchise__card on-orange" data-reveal>
        <div class="franchise__copy">
          <p class="eyebrow eyebrow--plain franchise__eyebrow">{homeFranchise.eyebrow}</p>
          <h2 class="t-h2" id="franchise-title">{homeFranchise.title}</h2>
          <p class="franchise__lead">{growBusiness.body}</p>
          <ul role="list" class="franchise__points">
            {storePromise.benefits.slice(0, 4).map((b) => (
              <li><Icon name="check" /><span><strong>{b.title}:</strong> {b.body}</span></li>
            ))}
          </ul>
          <div class="cluster">
            <button type="button" class="btn btn--dark" data-open-dialog="dialog-franchise">Become a Partner <Icon name="arrow-right" /></button>
            <a class="btn btn--white" href="/franchise/">Franchise details</a>
          </div>
          <p class="franchise__call"><Icon name="phone" /> Call us now: <a href={`tel:${franchisePhone}`}>{franchisePhone}</a></p>
        </div>
        <div class="franchise__media">
          <Image src={storeInterior} alt="A Retina Paints exclusive showroom" widths={[480, 800]} sizes="(max-width: 960px) 100vw, 40vw" class="franchise__img" />
          <dl class="franchise__stats">
            {growBusiness.stats.map((s) => <div><dd>{s.value}</dd><dt>{s.label}</dt></div>)}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ NEWS ============ -->
  <section class="section section--flush-top news" aria-labelledby="news-title">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div class="stack" style="--stack: var(--s-4)">
          <p class="eyebrow">News &amp; Events</p>
          <h2 class="t-h2" id="news-title">{blogTitle}</h2>
        </div>
        <a class="link-arrow" href="/news-and-events/">All news &amp; events <Icon name="arrow-right" /></a>
      </div>
      <div class="news__grid">
        {posts.map((p, i) => (
          <article class="post" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="post__media">
              <Image src={p.cover} alt={p.coverAlt} widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 34vw" />
            </div>
            <div class="post__body">
              <p class="post__meta"><span class="post__cat">{p.category}</span><time datetime={p.date}>{fmtDate(p.date)}</time></p>
              <h3 class="t-h3"><a href={`/${p.slug}/`}>{p.title}</a></h3>
            </div>
          </article>
        ))}
        <aside class="ann" aria-labelledby="ann-title" data-reveal style="--reveal-delay: 180ms">
          <h3 class="ann__title" id="ann-title">General announcements</h3>
          <ul role="list">
            {announcements.slice(0, 5).map((a) => (
              <li>
                <a href={docUrl(a.href)} target="_blank" rel="noopener">
                  <Icon name="file-text" />
                  <span>{a.label}<span class="sr-only"> (PDF, opens in a new tab)</span></span>
                </a>
              </li>
            ))}
          </ul>
          <a class="link-arrow" href="/news-and-events/#announcements">View all announcements <Icon name="arrow-right" /></a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Franchise prompt (the live homepage shows this as a pop-up) -->
  <Fragment slot="after">
    <aside class="promo" aria-labelledby="promo-title" hidden data-promo>
      <button type="button" class="promo__close" aria-label="Dismiss" data-promo-close><Icon name="close" /></button>
      <p class="eyebrow">Franchise</p>
      <h2 id="promo-title">{franchisePromo.title}</h2>
      {franchisePromo.lines.map((l) => <p>{l}</p>)}
      <div class="promo__actions">
        <a class="btn btn--sm" href="/franchise/">Know More</a>
        <button type="button" class="btn btn--sm btn--secondary" data-open-dialog="dialog-promo-video"><Icon name="play" /> Watch</button>
        <button type="button" class="promo__later" data-promo-close>Maybe Later</button>
      </div>
    </aside>
    <Modal id="dialog-promo-video" title={franchisePromo.title} eyebrow="Franchise" size="lg">
      <VideoEmbed id={franchisePromo.youtubeId} title="Own a Retina Paints Franchise" />
    </Modal>
  </Fragment>
</BaseLayout>

<script>
  // Hero: the docked palette repaints the room (radio group with arrow-key support).
  const hero = document.querySelector<HTMLElement>('[data-hero-room]');
  if (hero) {
    const code = hero.querySelector<HTMLElement>('[data-hero-code]')!;
    const link = hero.querySelector<HTMLAnchorElement>('[data-hero-link]')!;
    const chips = Array.from(hero.querySelectorAll<HTMLButtonElement>('.hero__chip'));
    const pick = (chip: HTMLButtonElement, focus = false) => {
      hero.style.setProperty('--wall', chip.dataset.hex!);
      chips.forEach((c) => {
        const on = c === chip;
        c.setAttribute('aria-checked', String(on));
        c.tabIndex = on ? 0 : -1;
      });
      if (code.textContent !== chip.dataset.code) {
        code.textContent = chip.dataset.code!;
        code.removeAttribute('data-swap');
        void code.offsetWidth; // restart the label animation
        code.setAttribute('data-swap', '');
      }
      link.href = `/colors/#${chip.dataset.code}`;
      link.setAttribute('aria-label', `Open ${chip.dataset.code} in the colour visualizer`);
      if (focus) chip.focus();
    };
    chips.forEach((chip, i) => {
      chip.addEventListener('click', () => pick(chip));
      chip.addEventListener('keydown', (e) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
        if (step === undefined) return;
        e.preventDefault();
        pick(chips[(i + step + chips.length) % chips.length], true);
      });
    });
  }

  // Franchise prompt: shown once per session, after the visitor engages.
  const promo = document.querySelector<HTMLElement>('[data-promo]');
  if (promo) {
    let seen = false;
    try { seen = sessionStorage.getItem('rp-promo') === '1'; } catch {}
    const show = () => {
      if (seen) return;
      seen = true;
      promo.hidden = false;
      try { sessionStorage.setItem('rp-promo', '1'); } catch {}
    };
    if (!seen) {
      // Never pop up over a tool the visitor is using (the colour visualizer); wait until it is off-screen.
      const avoid = Array.from(document.querySelectorAll<HTMLElement>('[data-float-avoid]'));
      const busy = () => avoid.some((el) => {
        const r = el.getBoundingClientRect();
        return r.top < window.innerHeight && r.bottom > 0;
      });
      let due = false;
      const attempt = () => {
        if (!due || busy()) return;
        window.removeEventListener('scroll', onScroll);
        show();
      };
      const onScroll = () => {
        if (window.scrollY > document.documentElement.scrollHeight * 0.35) due = true;
        attempt();
      };
      window.setTimeout(() => { due = true; attempt(); }, 15000);
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    promo.querySelectorAll('[data-promo-close]').forEach((b) => b.addEventListener('click', () => (promo.hidden = true)));
  }
</script>

<style>
  /* ---------- Hero ---------- */
  /* Split hero: a charcoal copy panel on the left, the painted room on the right with a floating shade bar. */
  .hero {
    --hero-bg: #1c1612;
    --hero-text: #fffaf4;
    --hero-soft: rgb(255 246 236 / 0.76);
    --hero-line: rgb(255 255 255 / 0.14);
    --edge: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 44fr) minmax(0, 56fr);
    min-height: clamp(36rem, calc(100svh - var(--header-h) - 3.5rem), 50rem);
    background: var(--hero-bg);
    color: var(--hero-text);
    overflow: hidden;
  }

  /* Copy panel */
  .hero__panel {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--s-8);
    padding: clamp(2.5rem, 1.5rem + 3vw, 4.5rem) clamp(2rem, 1rem + 3vw, 4rem) clamp(4rem, 3rem + 2.5vw, 5.5rem) var(--edge);
    background: radial-gradient(42rem 30rem at 0% 100%, rgb(242 129 33 / 0.16), transparent 70%), var(--hero-bg);
  }
  .hero__copy { align-self: center; display: grid; justify-items: start; gap: var(--s-5); width: 100%; max-width: 34rem; container-type: inline-size; }
  .hero__title {
    font-family: var(--font-display);
    /* "Your World", the widest line, is ~5.3em: never wider than the copy column */
    font-size: min(clamp(3rem, 1.5rem + 4vw, 5.5rem), 18cqi);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    color: var(--white);
  }
  .hero__line { display: block; white-space: nowrap; }
  .hero__accent { color: var(--orange-400); }
  .hero__lead { max-width: 31rem; font-size: var(--fs-lead); line-height: 1.6; color: var(--hero-soft); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-2); }
  .hero__ctas :global(.btn--ghost-light:hover .icon) { color: var(--orange-300); }

  .hero__trust {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    margin: 0;
    padding: var(--s-5) 0 0;
    list-style: none;
    border-top: 1px solid var(--hero-line);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--hero-soft);
  }
  .hero__trust li { display: flex; align-items: center; gap: 0.55rem; padding-right: var(--s-4); white-space: nowrap; }
  .hero__trust li + li { padding-left: var(--s-4); border-left: 1px solid var(--hero-line); }
  .hero__trust-icon { display: grid; place-items: center; flex: none; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: rgb(242 129 33 / 0.16); color: var(--orange-300); }
  .hero__trust-icon :global(.icon) { width: 1.1rem; height: 1.1rem; }

  /* Room photograph */
  .hero__media { position: relative; min-height: 100%; }
  .hero__media::before { content: ''; position: absolute; inset: 0 auto 0 0; z-index: 1; width: 14%; background: linear-gradient(to right, rgb(28 22 18 / 0.55), transparent); pointer-events: none; }
  .hero__scene { position: absolute; inset: 0; isolation: isolate; overflow: hidden; }
  .hero__paint { position: absolute; inset: 0; background: var(--wall); transition: background-color 800ms var(--ease-in-out); }
  .hero__scene img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 58% 60%; }
  .hero__shade { mix-blend-mode: multiply; }
  .hero__light { mix-blend-mode: screen; }

  /* Floating shade bar over the room */
  .shadebar {
    position: absolute;
    left: 50%;
    bottom: clamp(3.5rem, 2.5rem + 2.5vw, 5rem);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: 0.55rem 0.7rem 0.55rem 0.55rem;
    border-radius: var(--r-pill);
    background: var(--white);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.1), 0 24px 48px -20px rgb(0 0 0 / 0.55);
    color: var(--ink-deep);
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .shadebar__code { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.15rem 0.9rem 0.15rem 0.15rem; border-right: 1px solid var(--line); color: inherit; text-decoration: none; }
  .shadebar__code:focus-visible { outline: 2.5px solid var(--ink-deep); outline-offset: 3px; border-radius: var(--r-pill); }
  .shadebar__dot { width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--wall); box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1); transition: background-color 800ms var(--ease-in-out); }
  .shadebar__text { display: grid; line-height: 1.15; }
  .shadebar__label { font-size: 0.625rem; font-weight: 750; letter-spacing: 0.12em; text-transform: uppercase; color: var(--orange-700); }
  .shadebar__text strong { font-family: var(--font-display); font-size: 1rem; }

  .palette { display: flex; align-items: center; gap: 0.5rem; }
  .hero__chip, .palette__more {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1);
    transition: transform 220ms var(--ease-out), box-shadow 220ms var(--ease-out);
  }
  .hero__chip::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2.5px solid var(--orange-500); opacity: 0; transform: scale(0.7); transition: opacity 240ms var(--ease-out), transform 300ms var(--ease-out); }
  .hero__chip:hover, .palette__more:hover { transform: scale(1.12); }
  .hero__chip:focus-visible, .palette__more:focus-visible { outline: 2.5px solid var(--ink-deep); outline-offset: 5px; }
  .hero__chip[aria-checked='true']::after { opacity: 1; transform: none; }
  .hero__chip :global(.hero__chip-check) { width: 1rem; height: 1rem; stroke-width: 3; opacity: 0; transform: scale(0.4); transition: opacity 220ms, transform 300ms var(--ease-out); }
  .hero__chip[data-ink='dark'] { color: var(--ink-deep); }
  .hero__chip[data-ink='light'] { color: var(--white); }
  .hero__chip[aria-checked='true'] :global(.hero__chip-check) { opacity: 1; transform: none; }
  .palette__more { background: var(--orange-50); color: var(--orange-700); box-shadow: inset 0 0 0 1.5px var(--orange-200); text-decoration: none; }
  .palette__more :global(.icon) { width: 1.1rem; height: 1.1rem; stroke-width: 2.25; }
  .palette__tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.8rem);
    padding: 0.3rem 0.6rem;
    border-radius: var(--r-pill);
    background: var(--ink-deep);
    color: var(--white);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 6px);
    transition: opacity 180ms var(--ease-out), transform 240ms var(--ease-out);
  }
  .hero__chip:hover .palette__tip, .hero__chip:focus-visible .palette__tip,
  .palette__more:hover .palette__tip, .palette__more:focus-visible .palette__tip { opacity: 1; transform: translate(-50%, 0); }

  /* Entrance (once, on load) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__in { animation: hero-rise 800ms var(--ease-out) backwards; animation-delay: calc(80ms + var(--i, 0) * 90ms); }
    .hero__line { animation: line-in 900ms var(--ease-out) backwards; }
    .hero__line:nth-child(2) { animation-delay: 120ms; }
    .hero__line:nth-child(3) { animation-delay: 240ms; }
    .hero__scene { animation: hero-settle 1800ms var(--ease-out) backwards; }
    .shadebar { animation-name: bar-in; }
    .hero__chip, .palette__more { animation: chip-in 420ms var(--ease-out) backwards; animation-delay: calc(560ms + var(--i, 7) * 50ms); }
    [data-hero-code][data-swap] { animation: code-swap 360ms var(--ease-out); }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(22px); } }
  @keyframes line-in { from { opacity: 0; transform: translateY(0.4em); clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 -10% 0); } }
  @keyframes hero-settle { from { opacity: 0; transform: scale(1.06); } }
  @keyframes bar-in { from { opacity: 0; transform: translate(-50%, 18px); } }
  @keyframes chip-in { from { opacity: 0; transform: scale(0.4); } }
  @keyframes code-swap { from { opacity: 0; transform: translateY(6px); } }

  /* Wide screens: the copy aligns with the page container, so give its panel more of the width. */
  @media (min-width: 1600px) { .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  /* Laptops: a wider copy panel so the credentials stay on two lines each. */
  @media (min-width: 961px) and (max-width: 1400px) {
    .hero { grid-template-columns: minmax(0, 48fr) minmax(0, 52fr); }
    .hero__trust li { gap: 0.5rem; padding-right: var(--s-4); }
    .hero__trust li + li { padding-left: var(--s-4); }
    .hero__trust-icon { width: 2rem; height: 2rem; }
  }
  /* Small laptops */
  @media (min-width: 961px) and (max-width: 1180px) {
    .hero { grid-template-columns: minmax(0, 48fr) minmax(0, 52fr); }
    .hero__title { font-size: min(clamp(3rem, 0.5rem + 4.6vw, 4.25rem), 18cqi); }
    .hero__trust li { padding-right: var(--s-3); }
    .hero__trust li + li { padding-left: var(--s-3); }
    .shadebar__code { display: none; }
  }
  /* Short laptop screens (1280×720, 1366×768) */
  @media (min-width: 961px) and (max-height: 820px) {
    .hero__panel { padding-top: 2rem; padding-bottom: 3.25rem; gap: var(--s-5); }
    .hero__title { font-size: min(clamp(3rem, 0.5rem + 3.8vw, 4.25rem), 18cqi); }
    .hero__trust { padding-top: var(--s-4); }
    .hero__copy { gap: var(--s-4); }
  }

  /* Tablets and phones: the room leads, the shade bar sits on the seam, the copy panel follows. */
  @media (max-width: 960px) {
    .hero { display: flex; flex-direction: column; min-height: 0; }
    .hero__media { order: -1; aspect-ratio: 16 / 11; max-height: 62svh; min-height: 0; }
    .hero__media::before { display: none; }
    .shadebar { bottom: 0; transform: translate(-50%, 50%); }
    .hero__panel { padding: calc(var(--s-8) + 1.5rem) var(--gutter) clamp(3.5rem, 2.5rem + 4vw, 5rem); gap: var(--s-6); }
    .hero__copy { max-width: 40rem; }
    @media (prefers-reduced-motion: no-preference) { .shadebar { animation-name: bar-in-m; } }
  }
  @keyframes bar-in-m { from { opacity: 0; transform: translate(-50%, calc(50% + 18px)); } }
  @media (max-width: 560px) {
    .hero__title { font-size: min(18cqi, 4.25rem); }
    .hero__ctas { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; }
    .shadebar { left: var(--gutter); right: var(--gutter); justify-content: space-between; gap: var(--s-2); padding: 0.45rem; transform: translateY(50%); }
    .shadebar__code { display: none; }
    .palette { flex: 1; justify-content: space-between; gap: 0.25rem; }
    .hero__chip, .palette__more { width: min(2.5rem, calc((100vw - 2 * var(--gutter) - 3rem) / 8)); height: auto; aspect-ratio: 1; }
    .palette__tip { display: none; }
    .hero__trust { grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; font-size: 0.75rem; }
    .hero__trust li { flex-direction: column; align-items: flex-start; gap: 0.4rem; padding-right: var(--s-3); white-space: normal; }
    .hero__trust li + li { padding-left: var(--s-3); }
    .hero__trust-icon { width: 2rem; height: 2rem; }
    @media (prefers-reduced-motion: no-preference) { .shadebar { animation-name: bar-in-s; } }
  }
  @keyframes bar-in-s { from { opacity: 0; transform: translateY(calc(50% + 18px)); } }
  @media (min-width: 420px) and (max-width: 560px) {
    .hero__ctas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero__ctas :global(.btn) { padding-inline: 0.75rem; font-size: 0.975rem; }
  }

  /* ---------- Quick access ---------- */
  .quick { position: relative; z-index: 2; margin-top: calc(-1 * clamp(1rem, 0.5rem + 1.5vw, 2rem)); }
  .quick__list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--white);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .quick__item {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.55rem;
    padding: var(--s-6) var(--s-5) var(--s-6);
    transition: background-color var(--t-base);
  }
  .quick__item + .quick__item { border-left: 1px solid var(--line); }
  .quick__item:hover { background: var(--orange-50); }
  .quick__item::before { content: ''; position: absolute; left: var(--s-5); right: var(--s-5); top: 0; height: 3px; border-radius: 0 0 3px 3px; background: var(--orange-500); transform: scaleX(0); transform-origin: left; transition: transform 400ms var(--ease-out); }
  .quick__item:hover::before { transform: scaleX(1); }
  .quick__icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; margin-bottom: 0.25rem; border-radius: 14px; background: var(--orange-50); box-shadow: inset 0 0 0 1px var(--orange-200); color: var(--orange-700); transition: background-color 260ms var(--ease-out), color 260ms var(--ease-out), transform 300ms var(--ease-out); }
  .quick__icon :global(.icon) { width: 1.35rem; height: 1.35rem; stroke-width: 1.75; }
  .quick__item:hover .quick__icon { background: var(--orange-500); color: var(--white); box-shadow: none; transform: translateY(-2px); }
  .quick__title {
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink-deep);
    text-align: left;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .quick__title::after { content: ''; position: absolute; inset: 0; }
  .quick__title:focus-visible { outline: none; }
  .quick__item:has(.quick__title:focus-visible) { outline: 3px solid var(--ink-deep); outline-offset: -3px; }
  .quick__desc { font-size: 0.8125rem; line-height: 1.5; color: var(--ink-soft); }
  .quick__item :global(.quick__arrow) { position: absolute; right: var(--s-5); top: var(--s-6); width: 1.1rem; height: 1.1rem; color: var(--orange-600); opacity: 0; transform: translateX(-4px); transition: opacity var(--t-base), transform var(--t-base) var(--ease-out); }
  .quick__item:hover :global(.quick__arrow) { opacity: 1; transform: none; }
  @media (max-width: 1180px) {
    .quick__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .quick__item:nth-child(4) { border-left: 0; }
    .quick__item:nth-child(n + 4) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 640px) {
    .quick__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .quick__item { padding: var(--s-5) var(--s-4); }
    .quick__item:nth-child(4) { border-left: 1px solid var(--line); }
    .quick__item:nth-child(odd) { border-left: 0; }
    .quick__item:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .quick__desc { display: none; }
    .quick__item :global(.quick__arrow) { display: none; }
  }

  /* ---------- Exterior band ---------- */
  .exterior {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--white);
    background: #1d1a1f;
  }
  .exterior :global(.exterior__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }
  .exterior::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(20 16 14 / 0.86) 0%, rgb(20 16 14 / 0.62) 42%, rgb(20 16 14 / 0.08) 75%);
  }
  .exterior__inner {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s-8);
    align-items: end;
    padding-block: clamp(4rem, 3rem + 6vw, 8.5rem);
  }
  .exterior__copy { display: grid; gap: var(--s-5); justify-items: start; max-width: 36rem; }
  .exterior__copy h2 { color: var(--white); }
  .exterior__lead { font-size: var(--fs-lead); color: rgb(255 255 255 / 0.84); }
  .exterior__list { display: grid; gap: var(--s-3); margin: 0; padding: 0; list-style: none; }
  .exterior__item {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr) auto;
    gap: var(--s-4);
    align-items: center;
    padding: var(--s-3) var(--s-5) var(--s-3) var(--s-3);
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.1);
    backdrop-filter: blur(12px);
    color: var(--white);
    text-decoration: none;
    transition: background-color var(--t-base), border-color var(--t-base);
  }
  .exterior__item:hover { background: rgb(255 255 255 / 0.2); border-color: rgb(255 255 255 / 0.45); }
  .exterior__item :global(.exterior__pack) { width: 3.75rem; height: auto; }
  .exterior__item strong { display: block; font-family: var(--font-display); font-size: 1.0625rem; }
  .exterior__item span span { font-size: 0.85rem; color: var(--orange-200); }
  .exterior__item > :global(.icon) { color: var(--orange-300); }
  @media (max-width: 960px) {
    .exterior__inner { grid-template-columns: minmax(0, 1fr); }
    .exterior::before { background: linear-gradient(180deg, rgb(20 16 14 / 0.55) 0%, rgb(20 16 14 / 0.86) 60%); }
  }

  /* ---------- Section tones ---------- */
  .viz-section { position: relative; background: linear-gradient(180deg, var(--orange-50) 0%, var(--cream) 100%); }
  .viz-section::before { content: ''; position: absolute; left: 50%; top: 0; width: min(var(--container), 100% - 2 * var(--gutter)); height: 3px; transform: translateX(-50%); background: linear-gradient(90deg, var(--orange-500) 0 18%, var(--orange-300) 18% 26%, var(--orange-100) 26% 32%, transparent 32%); border-radius: 0 0 3px 3px; }
  .news { background: linear-gradient(180deg, var(--white) 30%, var(--cream) 100%); }

  /* ---------- Why ---------- */
  .why__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 1rem + 4vw, 6rem); align-items: start; }
  .why__head { position: sticky; top: calc(var(--header-h) + 2rem); display: grid; gap: var(--s-4); }
  .why__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  .why__item { position: relative; display: grid; gap: var(--s-3); align-content: start; padding: var(--s-6) 0 var(--s-7); border-top: 1px solid var(--line-strong); }
  .why__item::before { content: ''; position: absolute; left: 0; top: -1px; width: 3rem; height: 2px; background: var(--orange-500); transition: width 600ms var(--ease-out); }
  .why__item:hover::before { width: 100%; }
  .why__item .why__icon { transition: background-color 260ms var(--ease-out), color 260ms var(--ease-out); }
  .why__item:hover .why__icon { background: var(--orange-500); color: var(--ink-deep); }
  .why__num { position: absolute; top: var(--s-6); right: 0; font-family: var(--font-display); font-size: 0.875rem; font-weight: 700; color: var(--orange-700); }
  .why__icon { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: var(--r-md); background: var(--orange-100); color: var(--orange-700); margin-bottom: var(--s-2); }
  .why__icon :global(.icon) { width: 1.5rem; height: 1.5rem; }
  .why__item p { color: var(--ink-soft); font-size: 0.975rem; }
  @media (max-width: 960px) {
    .why__grid { grid-template-columns: minmax(0, 1fr); }
    .why__head { position: static; }
  }
  @media (max-width: 600px) { .why__list { grid-template-columns: minmax(0, 1fr); } }

  /* ---------- Story ---------- */
  .story__grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(2rem, 1rem + 4vw, 6rem); align-items: center; }
  .story__media { position: relative; padding: 0 12% 12% 0; isolation: isolate; }
  .story__media::before { content: ''; position: absolute; z-index: -1; left: -14%; top: -12%; width: 62%; aspect-ratio: 1; border-radius: 50%; border: 3.5rem solid rgb(242 129 33 / 0.08); }
  .story__media :global(.story__img) { border-radius: var(--r-lg); object-fit: cover; }
  .story__media :global(.story__img--main) { width: 100%; aspect-ratio: 4 / 3.4; box-shadow: var(--shadow-md); }
  .story__media :global(.story__img--small) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 1;
    border: 6px solid var(--white);
    box-shadow: var(--shadow-lg);
  }
  .story__stat {
    position: absolute;
    left: -1rem;
    top: 8%;
    display: grid;
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-md);
    background: var(--orange-500);
    color: var(--ink-deep);
    box-shadow: var(--shadow-md);
  }
  .story__stat strong { font-family: var(--font-display); font-size: 2.5rem; font-weight: 800; line-height: 1; letter-spacing: var(--tracking-display); }
  .story__stat span { font-size: 0.875rem; font-weight: 600; }
  .story__copy { display: grid; gap: var(--s-5); justify-items: start; }
  .story__vm { display: grid; gap: var(--s-3); margin: 0; padding: var(--s-5); border-radius: var(--r-md); background: var(--cream); width: 100%; }
  .story__vm div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: var(--s-3); }
  .story__vm dt { font-family: var(--font-display); font-weight: 700; color: var(--ink-deep); }
  .story__vm dd { margin: 0; color: var(--ink-soft); }
  .story__stats { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: var(--s-7); margin: 0; }
  .story__stats div { display: flex; flex-direction: column-reverse; }
  .story__stats dd { margin: 0; font-family: var(--font-display); font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem); font-weight: 750; letter-spacing: var(--tracking-display); color: var(--orange-600); line-height: 1.1; }
  .story__stats dt { font-size: 0.875rem; color: var(--ink-soft); }
  .creds {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin: clamp(3rem, 2rem + 3vw, 5rem) 0 0;
    padding: var(--s-6) 0 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .creds li { display: flex; gap: var(--s-3); align-items: flex-start; font-size: 0.925rem; color: var(--ink-soft); line-height: 1.5; }
  .creds :global(.icon) { width: 1.5rem; height: 1.5rem; color: var(--orange-600); }
