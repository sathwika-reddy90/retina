---
import { Image } from 'astro:assets';
import InvestorLayout from '@/layouts/InvestorLayout.astro';
import Modal from '@/components/Modal.astro';
import Icon from '@/components/Icon.astro';
import { directors } from '@/data/investors';

const initials = (n: string) => n.split(' ').map((w) => w[0]).slice(0, 2).join('');
const slug = (n: string) => n.toLowerCase().replace(/[^a-z]+/g, '-');
---

<InvestorLayout title="Board of Directors">
  <ul role="list" class="board">
    {directors.map((d) => (
      <li class="director">
        <div class="director__head">
          {d.photo ? (
            <Image src={d.photo} alt="" width={160} height={160} class="director__photo" />
          ) : (
            <span class="director__mono" aria-hidden="true">{initials(d.name)}</span>
          )}
          <div>
            <h2 class="t-h4">{d.name}</h2>
            <p class="director__role">{d.role}</p>
          </div>
        </div>
        <p class="director__qual">{d.qualification}</p>
        <p class="director__exp">{d.experience}</p>
        {d.directorships && (
          <button type="button" class="director__more" data-open-dialog={`dir-${slug(d.name)}`}>
            Directorship and full-time positions <Icon name="arrow-right" />
          </button>
        )}
      </li>
    ))}
  </ul>

  <Fragment slot="after">
    {directors.filter((d) => d.directorships).map((d) => (
      <Modal id={`dir-${slug(d.name)}`} eyebrow="Directorship and full-time positions" title={d.name} description={d.role}>
        <table class="dir-table">
          <thead><tr><th scope="col">#</th><th scope="col">Name of the body corporate</th><th scope="col">Designation</th></tr></thead>
          <tbody>
            {d.directorships!.map(([e, r], i) => <tr><td>{i + 1}</td><td>{e}</td><td>{r}</td></tr>)}
          </tbody>
        </table>
      </Modal>
    ))}
  </Fragment>
</InvestorLayout>

<style>
  .board { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  .director { display: grid; gap: var(--s-3); align-content: start; padding: var(--s-6); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--white); }
  .director__head { display: flex; gap: var(--s-4); align-items: center; padding-bottom: var(--s-4); border-bottom: 1px solid var(--line); }
  .director__head :global(.director__photo), .director__mono { flex: none; width: 4rem; height: 4rem; border-radius: 50%; object-fit: cover; }
  .director__mono { display: grid; place-items: center; background: var(--orange-100); color: var(--orange-800); font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; }
  .director__role { font-family: var(--font-display); font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-text); margin-top: 0.2rem; }
  .director__qual { font-weight: 600; color: var(--ink-deep); }
  .director__exp { font-size: var(--fs-small); color: var(--ink-soft); }
  .director__more { justify-self: start; display: inline-flex; align-items: center; gap: 0.45rem; margin-top: var(--s-2); padding: 0; border: 0; background: none; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-small); color: var(--ink-deep); }
  .director__more :global(.icon) { width: 1rem; height: 1rem; color: var(--orange-600); transition: transform var(--t-base); }
  .director__more:hover { color: var(--orange-700); }
  .director__more:hover :global(.icon) { transform: translateX(3px); }
  @media (max-width: 760px) { .board { grid-template-columns: minmax(0, 1fr); } }
  .dir-table th, .dir-table td { padding: 0.7rem 0.75rem; text-align: left; border-bottom: 1px solid var(--line); font-size: var(--fs-small); }
  .dir-table th { font-family: var(--font-display); font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); background: var(--cream); }
  .dir-table td:first-child { color: var(--ink-mute); width: 2.5rem; }
</style>
