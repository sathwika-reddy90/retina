---
import { Image } from 'astro:assets';
import AboutLayout from '@/layouts/AboutLayout.astro';
import Icon from '@/components/Icon.astro';
import { team } from '@/data/about';
---

<AboutLayout title="Management Team & Key Persons" description="Meet the management team and key persons of Retina Paints Limited.">
  <section class="section">
    <div class="container">
      <ul role="list" class="team">
        {team.map((t, i) => (
          <li class="person" data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <div class="person__photo">
              <Image src={t.photo} alt={t.name} widths={[320, 480, 640]} sizes="(max-width: 560px) 100vw, (max-width: 1000px) 45vw, 24vw" />
            </div>
            <h2 class="t-h4">{t.name}</h2>
            <p>{t.role}</p>
          </li>
        ))}
      </ul>
      <p class="team__more">
        <a class="link-arrow" href="/investor-relations/board-of-directors/">Board of Directors <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>
</AboutLayout>

<style>
  .team { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: var(--s-7) var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  .person { display: grid; gap: var(--s-2); }
  .person__photo { aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--r-lg); background: var(--cream); margin-bottom: var(--s-3); }
  .person__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; transition: transform var(--t-slow) var(--ease-out); }
  .person:hover .person__photo :global(img) { transform: scale(1.03); }
  .person p { color: var(--ink-soft); font-size: 0.95rem; }
  .team__more { margin-top: var(--s-8); padding-top: var(--s-5); border-top: 1px solid var(--line); }
</style>
