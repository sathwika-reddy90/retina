---
import { Image } from 'astro:assets';
import AboutLayout from '@/layouts/AboutLayout.astro';
import { milestones } from '@/data/about';
---

<AboutLayout title="History & Milestones" lead="From incorporation in 2010 to listing on the BSE SME Platform in 2023." description="History and milestones of Retina Paints Limited, from incorporation in 2010 to its BSE SME listing in 2023.">
  <section class="section">
    <div class="container">
      <ol role="list" class="timeline">
        {milestones.map((m, i) => (
          <li class:list={['tl', { 'tl--flip': i % 2 === 1 }]} data-reveal>
            <div class="tl__year" aria-hidden="true">{m.year}</div>
            <div class="tl__card">
              {m.image && (
                <div class:list={['tl__media', { 'tl__media--contain': m.image.contain }]}>
                  <Image src={m.image.src} alt={m.image.alt} widths={[400, 720]} sizes="(max-width: 860px) 100vw, 36vw" />
                </div>
              )}
              <div class="tl__body">
                <p class="sr-only">Year {m.year}</p>
                <h2 class="t-h3">{m.title}</h2>
                {m.body.length > 1 ? (
                  <ul role="list">{m.body.map((b) => <li>{b}</li>)}</ul>
                ) : (
                  m.body.map((b) => <p>{b}</p>)
                )}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</AboutLayout>

<style>
  .timeline { position: relative; display: grid; gap: clamp(2rem, 1.5rem + 2vw, 3.5rem); margin: 0; padding: 0; list-style: none; }
  .timeline::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: linear-gradient(var(--orange-500), var(--orange-200)); }
  .tl { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(3rem, 2rem + 4vw, 6rem); align-items: center; }
  .tl::before { content: ''; position: absolute; left: 50%; top: 50%; width: 1.1rem; height: 1.1rem; margin: -0.55rem 0 0 -0.55rem; border-radius: 50%; background: var(--white); border: 4px solid var(--orange-500); z-index: 1; }
  .tl__year { font-family: var(--font-display); font-size: clamp(3rem, 2rem + 5vw, 6.5rem); font-weight: 800; letter-spacing: -0.05em; line-height: 1; color: var(--orange-100); -webkit-text-stroke: 1.5px var(--orange-300); text-align: right; }
  .tl--flip .tl__year { order: 2; text-align: left; }
  .tl--flip .tl__card { order: 1; }
  .tl__card { display: grid; overflow: hidden; border-radius: var(--r-lg); background: var(--white); border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
  .tl__media { aspect-ratio: 16 / 9; overflow: hidden; background: var(--cream); }
  .tl__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .tl__media--contain { display: grid; place-items: center; padding: var(--s-6); }
  .tl__media--contain :global(img) { width: auto; height: 70%; object-fit: contain; }
  .tl__body { display: grid; gap: var(--s-3); padding: var(--s-5) var(--s-6) var(--s-6); color: var(--ink-soft); }
  .tl__body h2 { color: var(--ink-deep); }
  .tl__label { font-size: var(--fs-label); font-weight: 700; letter-spacing: var(--tracking-label); color: var(--accent-text); }
  .tl__body ul { display: grid; gap: var(--s-2); margin: 0; padding-left: 1.1rem; }
  .tl__body li::marker { color: var(--orange-500); }
  @media (max-width: 860px) {
    .timeline::before { left: 0.55rem; }
    .tl { grid-template-columns: minmax(0, 1fr); gap: var(--s-3); padding-left: 2.5rem; }
    .tl::before { left: 0.55rem; top: 1.25rem; }
    .tl__year, .tl--flip .tl__year { order: 0; text-align: left; font-size: 3rem; }
    .tl--flip .tl__card { order: 1; }
  }
</style>
